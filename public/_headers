# En-têtes HTTP appliqués par Cloudflare Pages.
# Les pages HTML gardent le comportement par défaut (revalidation à chaque visite).

# En-têtes de sécurité, pour tout le site.
# - HSTS : le navigateur n'utilise plus que https pendant 1 an.
# - nosniff : le navigateur respecte le type annoncé des fichiers.
# - Referrer-Policy : les sites externes ne voient que « laphilo.fr », pas la page d'origine.
# - X-Frame-Options : le site ne peut pas être affiché dans une iframe d'un autre site.
# - Permissions-Policy : caméra, micro, géolocalisation, etc. désactivés
#   (les lecteurs YouTube et Spotify n'en ont pas besoin).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Vignettes et photos des philosophes : rarement modifiées.
# 7 jours de cache navigateur, puis mise à jour en arrière-plan pendant 30 jours.
/pho/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/photo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Polices hébergées sur le site : ne changent jamais sous le même nom.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fichiers générés par Astro : leur nom contient une empreinte du contenu,
# un fichier modifié change donc de nom.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icônes et bannière de partage.
/favicon.ico
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/icon-*
  Cache-Control: public, max-age=2592000

/og-banner.webp
  Cache-Control: public, max-age=2592000

# CSS et JS ne sont pas versionnés (même nom après modification) :
# cache court pour qu'une mise à jour soit visible rapidement.
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
