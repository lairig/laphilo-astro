</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/home-portraits.js" defer></script>
<script src="/js/accordion.js" defer></script>
<script is:inline>
  /* Lien vers une branche (#branche-langage) : on ouvre son accordéon */
  function ouvrirBranche() {
    var item = location.hash.indexOf('#branche-') === 0 && document.getElementById(location.hash.slice(1));
    if (item && !item.classList.contains('expanded')) item.querySelector('.acc-toggle').click();
  }
  addEventListener('hashchange', ouvrirBranche);
  addEventListener('DOMContentLoaded', function () { setTimeout(ouvrirBranche, 0); });
</script>

</body>
</html>
