    intro: "Qu'est-ce que l'homme ? Pour Kant, cette question résume toutes les autres. L'être humain est-il un animal comme les autres, ou un être à part ? Qu'est-ce qui relève de la nature, et qu'est-ce qui relève de la culture ? Les sociétés humaines, si diverses, partagent-elles un fond commun ?",
    definition: 'Réflexion sur la nature et la condition humaines, et sur la place de l’homme dans le monde.',
    penseurs: [
      cle('emmanuel-kant', 'Kant', '« Qu’est-ce que l’homme ? »'),
      cle('max-scheler', 'Max Scheler', 'la place de l’homme dans le cosmos'),
      cle('helmuth-plessner', 'Helmuth Plessner', 'l’homme, être « excentrique »'),
      cle('claude-levi-strauss', 'Claude Lévi-Strauss', 'l’unité de l’esprit humain sous la diversité des cultures'),
    ],
    apprend: 'Savoir ce qui fait l’humain aide à respecter ce que nous avons en commun, comme ce qui nous distingue.',
    liens: [courant('Humanisme'), courant('Structuralisme')],
    aujourdhui: [],
  },
  {
    nom: 'La philosophie sociale et féministe', tag: 'Société · Domination · Reconnaissance', ytId: 'Ay5C5b1_7yw',
    intro: "D'où viennent les inégalités et les dominations, entre classes, entre femmes et hommes, entre peuples ? Pourquoi certaines personnes sont-elles invisibles ou méprisées ? Qu'est-ce qu'une société juste pour toutes et tous ? Ces pensées partent de l'expérience vécue pour critiquer les rapports de pouvoir.",
    definition: 'Analyse critique de la société, des rapports de pouvoir, des inégalités et des conditions d’une vie sociale juste.',
    penseurs: [
      cle('simone-de-beauvoir', 'Simone de Beauvoir', '« On ne naît pas femme, on le devient »'),
      cle('bell-hooks', 'bell hooks', 'féminisme, race et classe'),
      cle('axel-honneth', 'Axel Honneth', 'la lutte pour la reconnaissance'),
      cle('nancy-fraser', 'Nancy Fraser', 'redistribution et reconnaissance'),
      cle('judith-butler', 'Judith Butler', 'le genre comme performance'),
    ],
    apprend: 'Ce qui paraît naturel dans l’ordre social est souvent construit — et peut donc être changé.',
    liens: [courant('Féminisme'), courant('Anticolonialisme')],
    aujourdhui: [vivants('critique', 'Critique sociale & capitalisme'), vivants('genre', 'Féminisme & genre'), vivants('decolonial','Décolonisation & pensées du Sud')],
  },
  {
    nom: "L'éthique appliquée", tag: 'Bioéthique · Environnement · Numérique', ytId: 'CJjUrafFkUU',
    intro: "Peut-on modifier le génome humain ? Avons-nous des devoirs envers les animaux et les générations futures ? Qui est responsable quand un algorithme se trompe ? L'éthique appliquée confronte les grands principes moraux aux questions concrètes que posent la médecine, l'écologie et le numérique.",
    definition: 'Application de la réflexion morale aux problèmes concrets : bioéthique, éthique environnementale, éthique animale, éthique du numérique.',
    penseurs: [
      cle('hans-jonas', 'Hans Jonas', 'le principe responsabilité'),
      cle('peter-singer', 'Peter Singer', 'la libération animale'),
      cle('catherine-larrere', 'Catherine Larrère', 'l’éthique de l’environnement'),
      cle('martha-nussbaum', 'Martha Nussbaum', 'les capabilités et la dignité'),
    ],
    apprend: 'L’éthique appliquée montre que la philosophie n’est pas abstraite : elle aide à décider, ici et maintenant.',
    liens: [courant('Ecologisme'), courant('Utilitarisme')],
    aujourdhui: [vivants('ecologie', 'Écologie & vivant')],
  },
];
