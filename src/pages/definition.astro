  'La métaphysique': { code: 'metaphysique', de: 'de la métaphysique', frises: [SF.occMeta, SF.oriMeta] },
  "L'épistémologie": { code: 'epistemologie', de: "de l'épistémologie", frises: [SF.occCon, SF.oriCon] },
  "L'éthique": {
    code: 'ethique', de: "de l'éthique", frises: [SF.occPol, SF.oriPol],
    aujourdhui: [vivants('justice', 'Justice & démocratie')],
  },
  'La politique': {
    code: 'politique', de: 'de la politique', frises: [SF.occPol, SF.oriPol],
    aujourdhui: [vivants('justice', 'Justice & démocratie'), vivants('critique', 'Critique sociale & capitalisme')],
  },
  "L'esthétique": {
    code: 'esthetique', de: "de l'esthétique", frises: [SF.occTout],
    aujourdhui: [vivants('art', 'Art & esthétique')],
  },
  'La logique': { code: 'logique', de: 'de la logique', frises: [SF.occCon, SF.oriCon] },
  "L'esprit et le langage": {
    code: 'langage', de: 'du langage',
    frises: [SF.occCon, courant('Fonctionnalisme'), courant('Computationnalisme')],
    aujourdhui: [vivants('esprit-ia', 'Esprit, IA & technique')],
  },
};
const rechercheBranche = (code: string) => `/recherche/?branche=${code}`;

/* Branches spécialisées, les « philosophies de… » : présentées comme les 7
   branches (accordéon, vidéo, texte, philosophes clés, liens vers le site).
   ytId : identifiant de la vidéo YouTube (la partie après « v= » dans l'adresse) ;
   tant qu'il est vide, la vidéo n'est pas affichée. */
/* Typographie française : espace insécable avant ? ! : ; » et après « */
const fr = (t: string) => t.replace(/ ([?!:;»])/g, ' $1').replace(/« /g, '« ');
type Cle = Lien & { note: string };
const cle = (id: string, label: string, note: string): Cle => ({ ...penseur(id, label), note });
const nSpiritualite = parBranche.get('spiritualite') || 0;
const specialisees: {
  nom: string; tag: string; ytId: string; intro: string; definition: string;
  penseurs: Cle[]; apprend: string; liens: Lien[]; aujourdhui: Lien[];
}[] = [
  {
    nom: 'La philosophie des sciences', tag: 'Méthode · Preuve · Révolutions scientifiques', ytId: 'vfo1GxpeWnM',
