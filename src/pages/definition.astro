    penseurs: [
      cle('michel-de-montaigne', 'Montaigne', '« une tête bien faite plutôt que bien pleine »'),
      cle('jean-jacques-rousseau', 'Rousseau', '<em>Émile</em>, suivre la nature de l’enfant'),
