    ],
    apprend: 'Le droit n’est pas une simple technique : il traduit des choix sur ce que nous nous devons les uns aux autres.',
    liens: [SF.occPol],
    aujourdhui: [vivants('justice', 'Justice & démocratie')],
  },
  {
