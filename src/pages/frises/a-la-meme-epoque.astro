---
/* « À la même époque » : compagnon de la Frise des penseurs du monde.
   En haut, une recherche centre la page sur un penseur et montre ses
   contemporains dans les autres traditions (calcul dans le navigateur, sur
   /data/frise-penseurs-monde.json). En dessous, le tableau époque par époque,
   une colonne par tradition, écrit en dur (lisible sans JavaScript). */
import { getCollection } from 'astro:content';
import Favicons from '../../components/Favicons.astro';
import BackButton from '../../components/BackButton.astro';
import FriseFooter from '../../components/FriseFooter.astro';
import Fonts from '../../components/Fonts.astro';
import GoatCounter from '../../components/GoatCounter.astro';
import SeoHead from '../../components/SeoHead.astro';
import { groupesMonde } from '../../data/groupes-monde';
import { citations, floruit, poids } from '../../lib/contemporains';

/* Chaque penseur est placé dans la période où il avait environ 40 ans. */
const PERIODES: [number, number, string, string][] = [
  [-3000, -800, 'Avant 800 av. J.-C.', 'Les premières sagesses'],
  [-800, -200, '800 – 200 av. J.-C.', "L'âge axial"],
  [-200, 500, '200 av. J.-C. – 500', "L'Antiquité tardive"],
  [500, 1000, '500 – 1000', 'Le haut Moyen Âge'],
  [1000, 1300, '1000 – 1300', 'Le temps des grandes synthèses'],
  [1300, 1500, '1300 – 1500', 'La fin du Moyen Âge'],
  [1500, 1650, '1500 – 1650', 'Renaissance et Réformes'],
  [1650, 1780, '1650 – 1780', "L'âge classique et les Lumières"],
  [1780, 1850, '1780 – 1850', "L'âge des révolutions"],
  [1850, 1914, '1850 – 1914', 'Le second XIXᵉ siècle'],
  [1914, 1960, '1914 – 1960', 'Guerres mondiales et décolonisations'],
  [1960, 1990, '1960 – 1990', 'Le second XXᵉ siècle'],
  [1990, 9999, 'Depuis 1990', "Aujourd'hui"],
];
const VISIBLES = 5; // penseurs affichés par case, les autres sous « + N autres »

const philosophes = (await getCollection('philosophes')).filter((e) => e.data.groupe);
const cite = citations(philosophes);
const groupes = groupesMonde.filter((g) => philosophes.some((e) => e.data.groupe === g.id));
const GROUPES = groupes.map(({ id, label, court, color }) => ({ id, label, court, color }));

const lignes = PERIODES.map(([de, a, dates, nom], i) => {
  const dans = philosophes.filter((e) => { const f = floruit(e.data); return f >= de && f < a; });
  const cases = groupes.map((g) => dans
    .filter((e) => e.data.groupe === g.id)
    .sort((x, y) => poids(y.data, cite.get(y.id) ?? 0) - poids(x.data, cite.get(x.id) ?? 0) || x.data.year - y.data.year)
    .map((e) => ({ id: e.id, name: e.data.name, date: e.data.display_date })));
  return { i, de, a, dates, nom, cases, n: dans.length };
});

const title = 'À la même époque : les penseurs du monde côte à côte | LaPhilo.fr';
const description = "Qui pensait en Chine, en Inde, en terre d'islam ou en Afrique au temps de Platon, de Descartes ou de Kant ? Cherchez un philosophe pour voir ses contemporains dans les autres traditions, ou parcourez le tableau des grandes traditions, époque par époque.";
---
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead title={title} description={description} path="/frises/a-la-meme-epoque/" />
  <Fonts />
  <link rel="preload" href="/data/frise-penseurs-monde.json" as="fetch" crossorigin />
  <style is:global>
    :root {
      --bg: #160d05; --panel: #22140a; --line: rgba(212,168,67,.18); --parch: #f7ecce;
      --parch-dim: #c9b48a; --gold: #d4a843;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg) radial-gradient(ellipse 70% 50% at 15% 8%, #3a1c08 0%, transparent 60%) no-repeat;
      color: var(--parch); font-family: 'EB Garamond', Georgia, serif; min-height: 100vh; }
    a { color: var(--gold); }

    .fm-header { position: relative; text-align: center; padding: 3.2rem 16px .8rem; }
    .sitemap-switcher { position: absolute; top: 14px; right: 16px; display: flex; border: 2px solid rgba(200,150,42,.35);
      border-radius: 3px; box-shadow: 0 2px 10px rgba(0,0,0,.35); }
    .sitemap-btn { display: flex; align-items: center; gap: .35rem; padding: .32rem .65rem; background: rgba(30,18,8,.85); border: none;
      cursor: pointer; font-family: 'Cinzel', serif; font-size: .64rem; letter-spacing: .14em; text-transform: uppercase;
      color: rgba(247,236,206,.92); text-decoration: none; }
    .sitemap-btn:hover { background: rgba(60,36,12,.94); color: var(--gold); }
    .sitemap-btn[hidden] { display: none; }
    .sitemap-flag { font-size: .88rem; line-height: 1; }
    h1 { font-family: 'Cinzel Decorative', serif; color: var(--gold); font-size: clamp(1.35rem, 3.6vw, 2.2rem); letter-spacing: .05em;
      line-height: 1.2; text-shadow: 0 2px 18px rgba(180,130,20,.45); }
    .fm-sous-titre { font-family: 'Cinzel', serif; font-size: clamp(.66rem, 1.4vw, .8rem); letter-spacing: .2em; text-transform: uppercase;
      color: var(--parch-dim); margin-top: .7rem; }
    .vers-frise { display: inline-block; margin-top: .9rem; font-family: 'Cinzel', serif; font-size: .7rem; letter-spacing: .1em;
      text-decoration: none; color: var(--gold); border: 1px solid var(--line); border-radius: 4px; padding: .35rem .8rem;
      background: rgba(212,168,67,.06); }
    .vers-frise:hover { border-color: var(--gold); background: rgba(212,168,67,.14); }
    .btn { font-family: 'Cinzel', serif; font-size: .68rem; letter-spacing: .08em; cursor: pointer; color: var(--gold); text-decoration: none;
      background: rgba(212,168,67,.06); border: 1px solid var(--line); border-radius: 4px; padding: .3rem .6rem; }
    .btn:hover { border-color: var(--gold); }

    /* ── Recherche ── */
    .recherche { position: relative; max-width: 560px; margin: 1.4rem auto 0; padding: 0 16px; }
    .recherche label { display: block; text-align: center; font-family: 'Cinzel', serif; font-size: .7rem; letter-spacing: .14em;
      text-transform: uppercase; color: var(--gold); margin-bottom: .45rem; }
    #q { width: 100%; font: inherit; font-size: 1.1rem; color: var(--parch); background: var(--panel); border: 1px solid rgba(212,168,67,.4);
      border-radius: 6px; padding: .6rem .9rem; outline: none; }
    #q:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,168,67,.15); }
    #q::placeholder { color: rgba(201,180,138,.6); font-style: italic; }
    #suggestions { position: absolute; left: 16px; right: 16px; top: 100%; z-index: 20; list-style: none; background: var(--panel);
      border: 1px solid rgba(212,168,67,.4); border-top: 0; border-radius: 0 0 6px 6px; box-shadow: 0 10px 24px rgba(0,0,0,.6);
      max-height: 60vh; overflow-y: auto; }
    #suggestions[hidden] { display: none; }
    #suggestions li { display: flex; align-items: center; gap: .6rem; padding: .45rem .9rem; cursor: pointer; min-height: 44px; }
    #suggestions li[aria-selected="true"], #suggestions li:hover { background: rgba(212,168,67,.12); }
    #suggestions .pastille { width: .6rem; height: .6rem; border-radius: 50%; background: var(--c); flex: none; }
    #suggestions small { color: var(--parch-dim); margin-left: auto; white-space: nowrap; }

    /* ── Penseur choisi ── */
    #centre { max-width: 1100px; margin: 1.4rem auto 0; padding: 0 16px; scroll-margin-top: 12px; }
    #centre:empty { display: none; }
    .carte { background: var(--panel); border: 1px solid rgba(212,168,67,.35); border-top: 3px solid var(--c); border-radius: 8px;
      padding: 1rem 1.1rem 1.1rem; }
    .carte-tete { display: flex; gap: 1rem; align-items: center; }
    .carte-tete img { width: 64px; height: 64px; object-fit: cover; border-radius: 50%; border: 2px solid var(--c); flex-shrink: 0; }
    .carte-tete h2 { font-family: 'Cinzel', serif; font-size: 1.15rem; color: var(--c); }
    .carte-tete p { color: var(--parch-dim); }
    .carte-actions { margin-left: auto; align-self: flex-start; display: flex; gap: .4rem; flex-wrap: wrap; justify-content: flex-end; }
    .contemps-titre { font-family: 'Cinzel', serif; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold);
      margin-top: 1.1rem; }
    .contemps { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem 1.3rem; margin-top: .7rem; }
    .contemps h3 { font-family: 'Cinzel', serif; font-size: .7rem; letter-spacing: .1em; color: var(--c); border-bottom: 1px solid var(--line);
      padding-bottom: .25rem; margin-bottom: .4rem; text-transform: uppercase; }
    .contemps ul { list-style: none; display: grid; gap: .3rem; }
    .contemps li a { display: flex; align-items: center; gap: .5rem; text-decoration: none; color: var(--parch); line-height: 1.15; }
    .contemps li a:hover .n { color: var(--c); text-decoration: underline; }
    .contemps .mini { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--c); background: #2a1a0c; flex: none; }
    .contemps .mini.vide { display: inline-block; }
    .contemps small, .contemps .autres { color: var(--parch-dim); font-size: .9rem; }
    .contemps .autres { font-style: italic; }
    .vide-msg { color: var(--parch-dim); font-style: italic; }

    /* ── Tableau époque par époque ── */
    .tableau-titre { text-align: center; margin: 2.4rem 16px .3rem; font-family: 'Cinzel', serif; font-weight: 400; color: var(--gold);
      font-size: .9rem; letter-spacing: .16em; text-transform: uppercase; }
    .tableau-aide { text-align: center; color: var(--parch-dim); font-style: italic; padding: 0 16px; margin-bottom: 1rem; }
    .tableau { max-width: 1500px; margin: 0 auto 2.5rem; padding: 0 16px; }
    .t-entete, .periode { display: grid; grid-template-columns: 10.5rem repeat(var(--n), minmax(0, 1fr)); gap: 0 .6rem; }
    .t-entete { position: sticky; top: 0; z-index: 5; background: rgba(22,13,5,.96); border-bottom: 1px solid rgba(212,168,67,.35);
      padding: .5rem 0; }
    .t-entete span { font-family: 'Cinzel', serif; font-size: .66rem; letter-spacing: .06em; color: var(--c); display: flex; gap: .35rem;
      align-items: center; }
    .t-entete .pastille, .case h4 .pastille { width: .55rem; height: .55rem; border-radius: 50%; background: var(--c); flex: none; }
    .periode { border-bottom: 1px solid var(--line); padding: .7rem 0; scroll-margin-top: 50px; }
    .periode.ici { background: rgba(212,168,67,.07); box-shadow: inset 3px 0 0 var(--gold); }
    .p-nom { padding-left: .5rem; }
    .p-nom b { display: block; font-family: 'Cinzel', serif; font-weight: 600; font-size: .78rem; color: var(--gold); letter-spacing: .03em; }
    .p-nom span { display: block; color: var(--parch-dim); font-style: italic; font-size: .95rem; line-height: 1.2; margin-top: .15rem; }
    .case { min-width: 0; border-left: 2px solid color-mix(in srgb, var(--c) 45%, transparent); padding-left: .5rem; }
    .case h4 { display: none; }
    .case ul { list-style: none; }
    .case li { line-height: 1.2; margin-bottom: .22rem; }
    .case a { color: var(--parch); text-decoration: none; font-size: .95rem; }
    .case a:hover { color: var(--c); text-decoration: underline; }
    .case a.choisi { color: var(--c); font-weight: 700; }
    .case .vide { color: rgba(201,180,138,.35); }
    .case details summary { cursor: pointer; color: var(--parch-dim); font-style: italic; font-size: .9rem; list-style: none; }
    .case details summary::-webkit-details-marker { display: none; }
    .case details summary:hover { color: var(--gold); }
    .case details[open] summary { margin-bottom: .2rem; }

    .frise-footer { display: flex; flex-direction: column; align-items: center; gap: .55rem; padding: 1rem 16px 1.2rem;
      border-top: 1px solid rgba(180,130,20,.18); background: rgba(0,0,0,.18); }
    .footer-tagline { font-family: 'EB Garamond', serif; font-style: italic; font-size: .92rem; color: #c8962a; letter-spacing: .03em; }
    .ff-copy { font-family: 'EB Garamond', serif; font-style: italic; font-size: .72rem; color: #e8c870; text-align: center; opacity: .65; }

    /* Écran moyen : le tableau défile en largeur */
    @media (max-width: 1100px) and (min-width: 761px) {
      .tableau { overflow-x: auto; }
      .t-entete, .periode { min-width: 1040px; }
      .t-entete { position: static; }
    }
    /* Téléphone : une carte par période, les traditions l'une sous l'autre */
    @media (max-width: 760px) {
      .fm-header { padding: 3.2rem 16px .4rem; }
      .sitemap-btn { padding: .22rem .4rem; font-size: .56rem; letter-spacing: .07em; }
      .carte-tete { flex-wrap: wrap; }
      .carte-actions { margin-left: 0; justify-content: flex-start; }
      .carte-actions .btn { min-height: 40px; display: inline-flex; align-items: center; }
      .contemps { grid-template-columns: 1fr; }
      .t-entete { display: none; }
      .periode { display: block; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: .8rem .9rem;
        margin-bottom: .8rem; }
      .periode.ici { border-color: var(--gold); }
      .p-nom { padding: 0 0 .5rem; border-bottom: 1px solid var(--line); margin-bottom: .55rem; }
      .case { border-left: 0; padding: 0; margin-bottom: .6rem; }
      .case.sans { display: none; }
      .case h4 { display: flex; gap: .4rem; align-items: center; font-family: 'Cinzel', serif; font-weight: 400; font-size: .68rem;
        letter-spacing: .08em; text-transform: uppercase; color: var(--c); margin-bottom: .25rem; }
      .case ul { display: flex; flex-wrap: wrap; gap: .1rem .9rem; }
      .case li { margin: 0; }
      .case a { display: inline-block; padding: .3rem 0; font-size: 1rem; }
      .case details { width: 100%; }
      .case details summary { padding: .3rem 0; }
    }
  </style>
</head>
<body>
  <header class="fm-header">
    <div class="sitemap-switcher">
      <BackButton />
      <a href="/frises/" class="sitemap-btn"><span class="sitemap-flag" aria-hidden="true">≡</span><span class="sitemap-text">Frises</span></a>
      <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil"><span class="sitemap-flag" aria-hidden="true">⌂</span><span class="sitemap-text">Accueil</span></a>
    </div>
    <h1>À la même époque</h1>
    <p class="fm-sous-titre">Les penseurs du monde côte à côte</p>
    <a class="vers-frise" href="/frises/penseurs-du-monde/">← La Frise des penseurs du monde</a>
  </header>

  <div class="recherche" role="search">
    <label for="q">Choisir un penseur</label>
    <input id="q" type="search" autocomplete="off" spellcheck="false" placeholder="Platon, Confucius, Averroès, Kant…"
      role="combobox" aria-expanded="false" aria-controls="suggestions" aria-autocomplete="list" />
    <ul id="suggestions" role="listbox" hidden></ul>
  </div>

  <section id="centre" aria-live="polite"></section>

  <h2 class="tableau-titre">Les traditions, époque par époque</h2>
  <p class="tableau-aide">Chaque penseur figure dans la période où il avait environ 40 ans. Choisissez un nom pour voir ses contemporains.</p>
  <div class="tableau" style={`--n:${groupes.length}`}>
    <div class="t-entete" aria-hidden="true">
      <span></span>
      {groupes.map((g) => <span style={`--c:${g.color}`}><span class="pastille"></span>{g.court}</span>)}
    </div>
    {lignes.filter((l) => l.n > 0).map((l) => (
      <section class="periode" id={`periode-${l.i}`} data-de={l.de} data-a={l.a}>
        <h3 class="p-nom"><b>{l.dates}</b><span>{l.nom}</span></h3>
        {l.cases.map((liste, j) => (
          <div class={`case${liste.length ? '' : ' sans'}`} style={`--c:${groupes[j].color}`}>
            <h4><span class="pastille"></span>{groupes[j].court}</h4>
            {liste.length === 0 ? <span class="vide">—</span> : (
              <>
                <ul>
                  {liste.slice(0, VISIBLES).map((p) => (
                    <li><a href={`?p=${p.id}`} data-id={p.id} title={p.date}>{p.name}</a></li>
                  ))}
                </ul>
                {liste.length > VISIBLES && (
                  <details>
                    <summary>+ {liste.length - VISIBLES} autre{liste.length - VISIBLES > 1 ? 's' : ''}</summary>
                    <ul>
                      {liste.slice(VISIBLES).map((p) => (
                        <li><a href={`?p=${p.id}`} data-id={p.id} title={p.date}>{p.name}</a></li>
                      ))}
                    </ul>
                  </details>
                )}
              </>
            )}
          </div>
        ))}
      </section>
    ))}
  </div>

  <FriseFooter />

  <script is:inline define:vars={{ GROUPES }}>
  (() => {
    const AGE_ACTIF = 25, ECART_ANCIEN = 30, PAR_GROUPE = 6;
    const $ = (id) => document.getElementById(id);
    const G = Object.fromEntries(GROUPES.map((g) => [g.id, g]));
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const centre = $('centre'), q = $('q'), sugg = $('suggestions');
    let DATA = [], parId = {};

    /* Contemporains : vies actives (dès 25 ans) qui se recouvrent ; avant l'an
       1000, dates approximatives, 30 ans d'écart tolérés. Les plus marquants
       d'abord (importance, citations), à poids égal le plus proche. */
    function contemporains(a) {
      return GROUPES.filter((g) => g.id !== a.g).map((g) => {
        const liste = DATA.filter((b) => b.g === g.id
          && Math.max(a.actif, b.actif) - Math.min(a.e, b.e) <= (Math.min(a.y, b.y) < 1000 ? ECART_ANCIEN : 0))
          .map((b) => ({ b, score: b.poids - Math.abs(a.milieu - b.milieu) }))
          .sort((x, y) => y.score - x.score);
        return { g, total: liste.length, liste: liste.slice(0, PAR_GROUPE).map((x) => x.b).sort((x, y) => x.y - y.y) };
      }).filter((x) => x.total);
    }

    function afficher(id, defiler) {
      const s = parId[id];
      document.querySelectorAll('.case a.choisi').forEach((a) => a.classList.remove('choisi'));
      document.querySelectorAll('.periode.ici').forEach((p) => p.classList.remove('ici'));
      if (!s) { centre.innerHTML = ''; return; }
      const g = G[s.g];
      const blocs = contemporains(s);
      centre.innerHTML = `<div class="carte" style="--c:${g.color}">
        <div class="carte-tete">${s.th ? `<img src="${esc(s.th)}" alt="" width="64" height="64">` : ''}
          <div><h2>${esc(s.n)}</h2><p>${esc(s.d)} · ${esc(g.label)}</p><p>${esc(s.x)}</p></div>
          <div class="carte-actions"><a class="btn" href="/philosophes/${esc(s.id)}/">Voir la fiche →</a>
          <a class="btn" href="/frises/penseurs-du-monde/?p=${encodeURIComponent(s.id)}">Voir sur la frise</a></div></div>
        <p class="contemps-titre">À la même époque, ailleurs dans le monde</p>
        <div class="contemps">${blocs.length ? blocs.map(({ g, total, liste }) => `<div style="--c:${g.color}"><h3>${esc(g.court)} · ${total}</h3><ul>`
          + liste.map((d) => `<li><a href="?p=${encodeURIComponent(d.id)}" data-id="${esc(d.id)}">`
            + (d.th ? `<img class="mini" src="${esc(d.th)}" alt="" width="32" height="32" loading="lazy">` : '<span class="mini vide"></span>')
            + `<span><span class="n">${esc(d.n)}</span><br><small>${esc(d.d)}</small></span></a></li>`).join('')
          + (total > liste.length ? `<li class="autres">et ${total - liste.length} autre${total - liste.length > 1 ? 's' : ''}</li>` : '')
          + '</ul></div>').join('')
          : '<p class="vide-msg">Aucun contemporain dans les autres traditions sur le site.</p>'}</div></div>`;
      // Dans le tableau : la période du penseur et son nom
      document.querySelectorAll(`.case a[data-id="${CSS.escape(id)}"]`).forEach((a) => {
        a.classList.add('choisi');
        const det = a.closest('details'); if (det) det.open = true;
        a.closest('.periode').classList.add('ici');
      });
      document.title = `${s.n} : ses contemporains dans le monde | LaPhilo.fr`;
      if (defiler) centre.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function choisir(id, defiler = true) {
      if (!parId[id]) return;
      history.pushState({ p: id }, '', '?p=' + encodeURIComponent(id));
      fermer(); q.value = ''; q.blur();
      afficher(id, defiler);
    }
    addEventListener('popstate', () => afficher(new URLSearchParams(location.search).get('p'), false));

    /* Liens « ?p=… » du tableau et de la carte : sans recharger la page */
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[data-id]');
      if (!a || !DATA.length || e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      choisir(a.dataset.id);
    });

    /* ── Suggestions ── */
    let res = [], sel = -1;
    function fermer() { sugg.hidden = true; q.setAttribute('aria-expanded', 'false'); sel = -1; }
    function suggerer() {
      const t = norm(q.value.trim());
      if (t.length < 2) { fermer(); return; }
      res = DATA.filter((d) => d.cle.includes(t))
        .sort((a, b) => (b.cle.startsWith(t) || b.cle.includes(' ' + t)) - (a.cle.startsWith(t) || a.cle.includes(' ' + t)) || b.poids - a.poids)
        .slice(0, 8);
      sel = res.length ? 0 : -1;
      sugg.innerHTML = res.length
        ? res.map((d, i) => `<li role="option" id="s-${i}" data-id="${esc(d.id)}" aria-selected="${i === sel}" style="--c:${G[d.g].color}">`
          + `<span class="pastille"></span>${esc(d.n)}<small>${esc(d.d)}</small></li>`).join('')
        : '<li aria-disabled="true"><em>Aucun penseur trouvé</em></li>';
      sugg.hidden = false;
      q.setAttribute('aria-expanded', 'true');
    }
    function marquer() {
      sugg.querySelectorAll('li[data-id]').forEach((li, i) => li.setAttribute('aria-selected', i === sel));
      if (sel >= 0) q.setAttribute('aria-activedescendant', 's-' + sel);
    }
    q.addEventListener('input', suggerer);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && res.length) { e.preventDefault(); sel = (sel + 1) % res.length; marquer(); }
      else if (e.key === 'ArrowUp' && res.length) { e.preventDefault(); sel = (sel - 1 + res.length) % res.length; marquer(); }
      else if (e.key === 'Enter' && sel >= 0 && !sugg.hidden) { e.preventDefault(); choisir(res[sel].id); }
      else if (e.key === 'Escape') fermer();
    });
    sugg.addEventListener('mousedown', (e) => e.preventDefault()); // garder le focus jusqu'au clic
    sugg.addEventListener('click', (e) => { const li = e.target.closest('li[data-id]'); if (li) choisir(li.dataset.id); });
    q.addEventListener('blur', () => setTimeout(fermer, 150));

    /* ── Chargement ── */
    fetch('/data/frise-penseurs-monde.json')
      .then((r) => r.json())
      .then((lignes) => {
        DATA = lignes.map(([id, n, y, e, d, g, s, th, x]) => ({
          id, n, y, e, d, g, th, x, actif: Math.min(y + AGE_ACTIF, e), milieu: (y + e) / 2,
          poids: Math.floor(s / 1000) * 100 + Math.min(s % 1000, 50) * 2, cle: norm(n),
        })).filter((d) => G[d.g]);
        parId = Object.fromEntries(DATA.map((d) => [d.id, d]));
        const p = new URLSearchParams(location.search).get('p');
        if (p) afficher(p, false);
      });
  })();
  </script>
</body>
</html>
