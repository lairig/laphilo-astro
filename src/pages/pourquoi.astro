---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';

const title = 'Pourquoi ce site ? | LaPhilo.fr';
const description = 'La genèse de LaPhilo.fr : pourquoi ce site, par qui, et le lien entre philosophie et musique dans le projet Lairig.';
const PHOTOS = [
  ['/photo/lairig-nature.webp', 'Nature', 'Marcher, écouter le paysage : c’est souvent là que naissent les premières notes.'],
  ['/photo/lairig-outside.webp', 'Vibration', 'Bols chantants et gongs : quand le son se partage et se ressent autant qu’il s’écoute.'],
  ['/photo/lairig-man.webp', 'Sérénité', 'Face à l’eau, le temps ralentit et les idées trouvent le calme pour se déposer.'],
];
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead title={title} description={description} path="/pourquoi/" ariane={[['Pourquoi ce site ?', '/pourquoi/']]} />

  <Fonts faces={['Cinzel Decorative 700', 'Cinzel 400', 'Cinzel 600', 'Cinzel 700', 'EB Garamond 400', 'EB Garamond 500', 'EB Garamond 400 italic']} />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    /* Page « Pourquoi ce site ? » : portrait sur fond sombre, parchemin pour la genèse
       (comme la page Bienvenue), carte violet nuit pour Lairig, photos encadrées d'or. */
    .pq { max-width: 900px; margin: 0 auto; padding: 0 1.5rem 3.5rem; }
    .pq-titre {
      margin: 0 0 1.1rem; text-align: center;
      font-family: 'Cinzel', serif; font-size: .85rem; font-weight: 400; letter-spacing: .2em; text-transform: uppercase;
      color: var(--gold-light, #d4a843); text-shadow: 0 1px 12px rgba(180, 130, 20, .35);
    }
    .pq-titre::before, .pq-titre::after { content: ' ✦ '; }

    /* Portrait */
    .pq-portrait { text-align: center; margin: .4rem auto 2.6rem; max-width: 700px; }
    .pq-avatar {
      width: 148px; height: 148px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 1.1rem;
      border: 3px solid var(--gold-light, #d4a843);
      box-shadow: 0 0 0 6px rgba(212, 168, 67, .14), 0 0 40px rgba(212, 168, 67, .28), 0 10px 30px rgba(0, 0, 0, .55);
      background: #2a1806;
    }
    .pq-nom {
      margin: 0 0 .9rem; font-family: 'Cinzel', serif; font-size: 1rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      color: #fff4dc;
    }
    .pq-nom span { display: block; margin-top: .25rem; font-size: .72rem; font-weight: 400; letter-spacing: .2em; color: var(--gold-light, #d4a843); }
    .pq-intro { margin: 0; font-family: 'EB Garamond', serif; font-style: italic; font-size: 1.14rem; line-height: 1.7; color: #ead9a8; }

    /* Genèse : parchemin à lettrine */
    .pq-parch {
      position: relative; overflow: hidden; padding: 1.7rem 2.1rem 1.5rem;
      background: linear-gradient(150deg, #f7efcc 0%, #ead8a0 45%, #e0cb8a 100%), var(--noise, none);
      border: 1px solid var(--parch-border, #b8923c); border-radius: var(--radius, 6px);
      box-shadow: 5px 5px 0 rgba(120, 80, 20, .2), 0 16px 48px rgba(10, 5, 2, .5);
    }
    .pq-parch::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; opacity: .6;
      background: linear-gradient(90deg, transparent, var(--gold, #b8860b), var(--rust, #8b3a0f), var(--gold, #b8860b), transparent);
    }
    .pq-parch p { margin: 0; font-family: 'EB Garamond', serif; font-size: 1.08rem; line-height: 1.75; color: var(--ink-mid, #3d2410); text-align: justify; }
    .pq-parch p + p { margin-top: .8rem; }
    .pq-lettrine::first-letter {
      font-family: 'Cinzel Decorative', serif; font-size: 3.3rem; font-weight: 700; color: var(--rust, #8b3a0f);
      float: left; line-height: .8; margin: .08em .12em 0 0;
    }

    /* Liens vers les grandes frises : dans le texte, puis encart sous le texte */
    .pq-parch strong { color: var(--rust, #8b3a0f); font-weight: 600; }
    .pq-parch p a { color: var(--rust, #8b3a0f); font-weight: 500; text-decoration: none; border-bottom: 1px solid rgba(139, 58, 15, .4); transition: border-color .2s, background .2s; }
    .pq-parch p a:hover { border-bottom-color: var(--rust, #8b3a0f); background: rgba(184, 134, 11, .12); }
    .pq-explorer { margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid rgba(180, 130, 50, .35); }
    .pq-explorer .pq-explorer-titre {
      margin: 0 0 .8rem; text-align: center; font-family: 'Cinzel', serif; font-size: .7rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--rust, #8b3a0f);
    }
    .pq-explorer-grille { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
    .pq-explorer-bloc {
      display: flex; flex-direction: column; gap: .45rem; padding: .8rem .9rem;
      background: rgba(30, 18, 8, .86); border: 1px solid rgba(212, 168, 67, .5); border-radius: 6px; box-shadow: 0 4px 14px rgba(60, 35, 5, .3);
    }
    .pq-explorer-nom { font-family: 'Cinzel', serif; font-size: .74rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #fff4dc; margin-bottom: .1rem; }
    .pq-explorer-bloc a {
      display: flex; align-items: center; gap: .6rem; padding: .35rem .4rem; border-radius: 4px; text-decoration: none;
      font-family: 'EB Garamond', serif; font-style: italic; font-size: 1.02rem; color: #e6cf94; transition: background .2s, color .2s;
    }
    .pq-explorer-bloc a:hover { background: rgba(212, 168, 67, .14); color: #fff4dc; }
    .pq-pastille {
      flex-shrink: 0; width: 1.9rem; height: 1.9rem; border-radius: 50%; display: grid; place-items: center;
      font-style: normal; font-size: .95rem; color: #2a1806;
      background: radial-gradient(circle at 33% 33%, #f3d78a, var(--gold, #b8860b) 60%, #6b4700);
      box-shadow: inset 0 1px 2px rgba(255, 255, 255, .5), 0 2px 5px rgba(0, 0, 0, .45);
    }

    /* Séparation au-dessus de la citation : filet doré qui s'efface, étoile au centre */
    .pq-separation { display: flex; align-items: center; gap: .8rem; max-width: 520px; margin: 2.8rem auto 0; color: var(--gold, #b8860b); }
    .pq-separation::before, .pq-separation::after { content: ''; flex: 1; height: 1px; }
    .pq-separation::before { background: linear-gradient(90deg, transparent, rgba(212, 168, 67, .6)); }
    .pq-separation::after { background: linear-gradient(90deg, rgba(212, 168, 67, .6), transparent); }
    .pq-separation span { font-size: .8rem; opacity: .85; }
    .pq-separation--dessous { margin: 0 auto 2.8rem; }

    /* Citation */
    .pq-citation { margin: 1.8rem auto; max-width: 640px; text-align: center; }
    .pq-citation blockquote {
      margin: 0; font-family: 'EB Garamond', serif; font-style: italic; font-size: 1.55rem; line-height: 1.4; color: #f1e3bd;
      text-shadow: 0 2px 18px rgba(212, 168, 67, .25);
    }
    .pq-citation blockquote::before, .pq-citation blockquote::after { font-family: 'Cinzel Decorative', serif; color: var(--gold-light, #d4a843); font-style: normal; }
    .pq-citation blockquote::before { content: '«\00a0'; }
    .pq-citation blockquote::after { content: '\00a0»'; }
    .pq-citation figcaption { margin-top: .6rem; font-family: 'Cinzel', serif; font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; color: var(--gold, #b8860b); }
    .pq-citation figcaption::before { content: '— '; }

    /* Lairig : carte violet nuit */
    .pq-lairig {
      position: relative; overflow: hidden; padding: 1.7rem 2.1rem 1.6rem; border-radius: 6px;
      background: radial-gradient(circle at 88% 8%, rgba(160, 140, 235, .22), transparent 55%), linear-gradient(160deg, #2b2352 0%, #1c1638 60%, #120e24 100%);
      border: 1px solid rgba(170, 150, 240, .45);
      box-shadow: 0 16px 48px rgba(5, 3, 15, .55);
    }
    .pq-lairig::before {
      content: '♪'; position: absolute; right: 1.2rem; bottom: -1.6rem; font-size: 9rem; line-height: 1; color: rgba(185, 168, 240, .08); pointer-events: none;
    }
    .pq-lairig p { position: relative; margin: 0; font-family: 'EB Garamond', serif; font-size: 1.08rem; line-height: 1.75; color: #e4def8; text-align: justify; }
    .pq-lairig p + p { margin-top: .8rem; }
    .pq-lairig strong { color: #fff; font-weight: 500; }
    .pq-lairig-lien {
      position: relative; display: inline-flex; align-items: center; gap: .5rem; margin-top: 1.3rem; padding: .75rem 1.4rem;
      font-family: 'Cinzel', serif; font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; text-decoration: none;
      color: #1c1638; background: linear-gradient(150deg, #e2d8ff 0%, #b9a8f0 60%, #9a86e0 100%); border-radius: 4px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .4); transition: transform .15s, filter .15s;
    }
    .pq-lairig-lien:hover { transform: translateY(-1px); filter: brightness(1.07); }
    .pq-titre--lairig { color: #c9bbf5; text-shadow: 0 1px 12px rgba(150, 130, 230, .35); }

    /* Photos */
    .pq-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.8rem; }
    .pq-photo { margin: 0; text-align: center; }
    .pq-photo-cadre {
      overflow: hidden; aspect-ratio: 4 / 3; border-radius: 6px; border: 1px solid rgba(212, 168, 67, .55);
      box-shadow: 0 8px 26px rgba(0, 0, 0, .5);
    }
    .pq-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
    .pq-photo:hover img { transform: scale(1.05); }
    .pq-photo figcaption span { display: block; margin: .35rem auto 0; max-width: 260px; font-family: 'EB Garamond', serif; font-style: italic; font-size: .98rem; line-height: 1.45; letter-spacing: 0; text-transform: none; color: #d9c48f; }
    .pq-photo figcaption { margin-top: .6rem; font-family: 'Cinzel', serif; font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: var(--gold-light, #d4a843); }

    @media (max-width: 600px) {
      .pq { padding: 0 1rem 2.5rem; }
      .pq-avatar { width: 120px; height: 120px; }
      .pq-intro { font-size: 1.05rem; }
      .pq-parch, .pq-lairig { padding: 1.25rem 1.1rem 1.15rem; }
      .pq-parch p, .pq-lairig p { font-size: 1.02rem; text-align: left; }
      .pq-lettrine::first-letter { font-size: 2.5rem; }
      .pq-citation { margin: 1.5rem auto; }
      .pq-separation { margin-top: 2.2rem; }
      .pq-separation--dessous { margin: 0 auto 2.2rem; }
      .pq-citation blockquote { font-size: 1.3rem; }
      .pq-lairig-lien { display: flex; justify-content: center; }
      .pq-photos { grid-template-columns: 1fr; gap: 1.3rem; }
      .pq-explorer-grille { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Pourquoi ce Site ?</h1>
  <p class="site-subtitle">Portrait · Genèse du projet</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="pq">

  <section class="pq-portrait" aria-label="Portrait">
    <img src="/photo/lairig-profil.webp" class="pq-avatar" alt="Portrait du créateur de LaPhilo.fr" width="148" height="148" />
    <p class="pq-nom">Créateur de LaPhilo.fr<span>&amp; musicien (Lairig)</span></p>
    <p class="pq-intro">
      Passionné de philosophie depuis l'adolescence, j'ai toujours cherché à comprendre le monde à travers les grandes questions que les penseurs de tous les temps ont osé poser : Qu'est-ce que la vérité ? Comment vivre ? Quelle est la nature de l'être ? Cette curiosité ne m'a jamais quitté.
    </p>
  </section>

  <section aria-labelledby="pq-genese">
    <h2 class="pq-titre" id="pq-genese">La genèse de LaPhilo.fr</h2>
    <div class="pq-parch">
      <p class="pq-lettrine">
        Ce site est né d'un constat simple : la philosophie est immense, souvent intimidante, et pourtant profondément humaine. J'ai longtemps cherché sur le web une frise temporelle qui montre d'un seul regard qui a pensé quoi, à quelle époque, et aux côtés de qui. <strong>Je n'en ai trouvé aucune.</strong> Les encyclopédies alignent des articles, les manuels des listes de noms ; rien ne permettait de voir qu'Averroès et Maïmonide sont nés dans la même ville, Cordoue, à quelques années d'écart, ni de suivre une idée d'une culture à l'autre.
      </p>
      <p>
        J'ai donc voulu créer l'outil qui me manquait : un espace de découverte visuelle et chronologique — non pas un cours magistral, mais une invitation à voyager à travers les idées, les époques et les cultures, des sages de l'Égypte ancienne aux penseurs d'aujourd'hui.
      </p>
      <p>
        Les frises temporelles sont le cœur du projet : elles permettent de situer chaque penseur dans son contexte historique, de voir les filiations entre les courants, de comprendre comment une idée en engendre une autre à travers les siècles. La philosophie n'est pas une collection de citations isolées — c'est un dialogue vivant, qui dure depuis 2 500 ans.
      </p>
      <nav class="pq-explorer" aria-label="Les grandes frises du monde">
        <p class="pq-explorer-titre">Explorer les grandes frises</p>
        <div class="pq-explorer-grille">
          <div class="pq-explorer-bloc">
            <span class="pq-explorer-nom">Les penseurs du monde</span>
            <a href="/frises/penseurs-du-monde/"><span class="pq-pastille" aria-hidden="true">⟷</span>La frise</a>
            <a href="/frises/tableau-des-penseurs/"><span class="pq-pastille" aria-hidden="true">▦</span>Le tableau par époque</a>
          </div>
          <div class="pq-explorer-bloc">
            <span class="pq-explorer-nom">Les courants de pensée du monde</span>
            <a href="/frises/courants-du-monde/"><span class="pq-pastille" aria-hidden="true">⟷</span>La frise</a>
            <a href="/frises/tableau-des-courants/"><span class="pq-pastille" aria-hidden="true">▦</span>Le tableau par époque</a>
          </div>
        </div>
      </nav>
    </div>
  </section>

  <div class="pq-separation" aria-hidden="true"><span>✦</span></div>

  <figure class="pq-citation">
    <blockquote>Sans la musique, la vie serait une erreur.</blockquote>
    <figcaption>Nietzsche</figcaption>
  </figure>

  <div class="pq-separation pq-separation--dessous" aria-hidden="true"><span>✦</span></div>

  <section aria-labelledby="pq-lairig">
    <h2 class="pq-titre pq-titre--lairig" id="pq-lairig">♪ Lairig Music — l'autre face du projet</h2>
    <div class="pq-lairig">
      <p>
        En parallèle de LaPhilo.fr, je compose de la musique instrumentale sous le nom <strong>Lairig</strong>. Ce projet musical est né du même élan : créer des atmosphères propices à la contemplation, à la réflexion, à ce moment suspendu où une idée peut vraiment se déposer en vous.
      </p>
      <p>
        Philosophie et musique partagent quelque chose d'essentiel : elles cherchent toutes deux à dire ce que les mots ordinaires ne peuvent pas atteindre. C'est cette conviction qui est au cœur de ce projet double — un site, une bande-son, une seule intention.
      </p>
      <a href="/lairig/" class="pq-lairig-lien">♪ Découvrir Lairig Music →</a>
    </div>
  </section>

  <div class="pq-separation" aria-hidden="true"><span>✦</span></div>

  <div class="pq-photos">
    {PHOTOS.map(([src, legende, texte]) => (
      <figure class="pq-photo">
        <div class="pq-photo-cadre"><img src={src} alt={legende} loading="lazy" /></div>
        <figcaption>{legende}<span>{texte}</span></figcaption>
      </figure>
    ))}
  </div>

</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
    <a class="footer-social-btn" href="/vos-remarques/" aria-label="Vos remarques">
      <span class="footer-social-icon">✎</span>
      <span class="footer-social-label">Vos remarques</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script is:inline src="/js/home-main.js" defer></script>

</body>
</html>
