---
/* Ressources utilisées (refaite le 2026-10-06) : ce que lisent, écoutent et regardent les fiches.
   Liste et descriptions : src/data/ressources.json ; les nombres sont calculés ici à partir des
   fiches (liens des textes, podcasts France Culture, chaînes des vidéos), ils suivent donc le site. */
import { getCollection } from 'astro:content';
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import R from '../data/ressources.json';
import ADRESSES from '../data/chaines-youtube.json';

const fiches = [...(await getCollection('philosophes')), ...(await getCollection('courants'))];
const nf = (n: number) => n.toLocaleString('fr-FR');

/* Liens des textes, par domaine */
const parDomaine = new Map<string, number>();
let nbLiens = 0;
for (const f of fiches) {
  for (const [, url] of f.data.text.matchAll(/href="(https?:\/\/[^"]+)"/g)) {
    nbLiens++;
    try {
      const d = new URL(url).hostname.replace(/^www\./, '');
      parDomaine.set(d, (parDomaine.get(d) ?? 0) + 1);
    } catch { /* adresse invalide : ignorée */ }
  }
}
const liens = (domaines: string[]) => domaines.reduce((s, d) => s + (parDomaine.get(d) ?? 0), 0);
const lire = R.lire.map((r) => ({ ...r, n: liens(r.domaines) }));
const lireAussi = R.lireAussi.map((r) => ({ ...r, n: liens(r.domaines) })).filter((r) => r.n > 0).sort((a, b) => b.n - a.n);

/* Podcasts : numéro d'émission dans l'adresse du fichier audio (…/podcast09/10467-…) */
const parEmission = new Map<string, number>();
let nbAudios = 0;
for (const f of fiches) {
  for (const [, src] of f.data.text.matchAll(/<audio[\s\S]*?src="([^"]+)"/g)) {
    nbAudios++;
    const id = src.match(/podcast09\/(\d+)-/)?.[1] ?? '';
    parEmission.set(id, (parEmission.get(id) ?? 0) + 1);
  }
}
const emissions = R.emissions.map((e) => ({ ...e, n: parEmission.get(e.id) ?? 0 })).filter((e) => e.n > 0).sort((a, b) => b.n - a.n);

/* Vidéos : chaîne lue dans le crédit « "Titre" par Chaîne » */
const chaineDe = (credit?: string) => (credit ?? '')
  .replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'").replace(/&amp;/g, '&')
  .match(/\bpar\s+(.+?)\s*$/)?.[1]
  ?.replace(/^[\s"'«»]+|[\s"'«».]+$/g, '').toLowerCase() ?? '';
const videos = fiches.filter((f) => f.data.yt_id);
const chaines = R.chaines.map((c) => {
  const noms = [c.nom, ...(c.alias ?? [])].map((x) => x.toLowerCase());
  const siennes = videos.filter((f) => noms.includes(chaineDe(f.data.media_credit)));
  // vidéo d'exemple : celle de la fiche la plus importante, puis la plus ancienne
  const ex = siennes.slice().sort((a, b) => ((b.data as any).importance ?? 1) - ((a.data as any).importance ?? 1) || a.data.year - b.data.year)[0];
  return { ...c, n: siennes.length, video: ex?.data.yt_id, exemple: ex?.data.name };
}).filter((c) => c.n > 0);

/* Chaînes ajoutées d'elles-mêmes : au moins SEUIL vidéos sur le site, absentes de ressources.json
   (ni chaîne, ni alias, ni média). Nom = l'écriture la plus fréquente dans les crédits ; adresse
   trouvée par scripts/build-data.py (src/data/chaines-youtube.json), sinon une recherche YouTube. */
const SEUIL = 5;
const connues = new Set([...R.chaines.flatMap((c) => [c.nom, ...(c.alias ?? [])]), ...R.medias].map((x) => x.toLowerCase()));
const parCle = new Map<string, typeof videos>();
for (const f of videos) {
  const k = chaineDe(f.data.media_credit);
  if (k && !connues.has(k)) parCle.set(k, [...(parCle.get(k) ?? []), f]);
}
const ecriture = (credits: string[]) => {
  const n = new Map<string, number>();
  for (const c of credits) {
    const nom = c.replace(/&quot;/g, '"').match(/\bpar\s+(.+?)\s*$/)?.[1]?.replace(/^[\s"'«»]+|[\s"'«».]+$/g, '') ?? '';
    if (nom) n.set(nom, (n.get(nom) ?? 0) + 1);
  }
  return [...n.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? '';
};
for (const [k, siennes] of parCle) {
  if (siennes.length < SEUIL) continue;
  const ex = siennes.slice().sort((a, b) => ((b.data as any).importance ?? 1) - ((a.data as any).importance ?? 1) || a.data.year - b.data.year)[0];
  const nom = ecriture(siennes.map((f) => f.data.media_credit ?? ''));
  chaines.push({
    nom, desc: '', n: siennes.length, video: ex.data.yt_id, exemple: ex.data.name,
    url: (ADRESSES as Record<string, { url?: string }>)[k]?.url ?? `https://www.youtube.com/results?search_query=${encodeURIComponent(nom)}`,
  } as (typeof chaines)[number]);
}
const ordre = (c: { nom: string; n: number }) => (c.nom === 'Parole de Philosophe' || c.nom === 'Kosmos' ? -1 : c.n);
chaines.sort((a, b) => ordre(b) - ordre(a));
const medias = R.medias.map((m) => ({ nom: m, n: videos.filter((f) => chaineDe(f.data.media_credit) === m.toLowerCase()).length })).filter((m) => m.n > 0);
const nbChaines = new Set(videos.map((f) => chaineDe(f.data.media_credit)).filter(Boolean)).size;

const title = 'Ressources utilisées | LaPhilo.fr';
const description = 'Les sources de LaPhilo.fr : Wikipédia, Persée, les podcasts de France Culture et les chaînes YouTube de philosophie les plus utilisées.';
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead title={title} description={description} path="/ressources/" ariane={[['Ressources utilisées', '/ressources/']]} />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css?v=20261001" />
  <style>
    .res-chiffres { display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem; margin: 0 0 1.4rem; }
    .res-chiffre { text-align: center; padding: .7rem .4rem; border: 1px solid rgba(180,130,20,.3); border-radius: 6px; background: rgba(255,255,255,.04); }
    .res-chiffre b { display: block; font-family: 'Cinzel', serif; font-size: 1.35rem; color: var(--rust, #8b3a0f); }
    .res-chiffre span { font-size: .78rem; color: var(--ink-light); line-height: 1.3; display: block; }
    .res-titre { margin: 1.8rem 0 .7rem; font-family: 'Cinzel', serif; font-size: .95rem; letter-spacing: .12em; text-transform: uppercase; color: var(--rust, #8b3a0f); }
    .res-titre:first-of-type { margin-top: .4rem; }
    .res-n { font-family: 'Cinzel', serif; font-size: .62rem; letter-spacing: .04em; color: var(--rust, #8b3a0f); white-space: nowrap; }
    .res-icone { flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-family: 'Cinzel', serif; font-weight: 700; font-size: 1rem; border: 1px solid rgba(180,130,20,.35); }
    .res-aussi { margin: .2rem 0 0; font-size: .82rem; line-height: 1.7; color: var(--ink-light); }
    .res-aussi a { color: var(--ink); text-decoration: none; border-bottom: 1px solid rgba(139,58,15,.3); }
    .res-aussi a:hover { color: var(--rust, #8b3a0f); }
    .res-aussi small { color: var(--rust, #8b3a0f); font-size: .72rem; }
    .res-emissions { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .3rem; }
    .res-emissions li { display: flex; justify-content: space-between; gap: .8rem; align-items: baseline; font-size: .82rem; padding: .25rem 0; border-bottom: 1px dotted rgba(180,130,20,.3); }
    .res-emissions a { color: var(--ink); text-decoration: none; }
    .res-emissions a:hover { color: var(--rust, #8b3a0f); text-decoration: underline; }
    .res-emissions small { color: var(--ink-light); font-style: italic; }
    .res-merci { margin-top: 1.6rem; font-size: .83rem; line-height: 1.7; color: var(--ink-light); font-style: italic; }
    .soc-res-vlogo--vide { display: none; }
    @media (max-width: 640px) { .res-chiffres { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Ressources Utilisées</h1>
  <p class="site-subtitle">Ce que lisent, écoutent et regardent les fiches</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page">
<div class="soc-page-wrap">
  <p class="soc-res-intro">Les {nf(fiches.length)} fiches de LaPhilo.fr s'appuient sur des sources ouvertes et gratuites. Voici les plus utilisées, avec le nombre de fois où elles servent sur le site. Les vidéos YouTube ne se chargent qu'au clic.</p>

  <div class="res-chiffres">
    <div class="res-chiffre"><b>{nf(nbLiens)}</b><span>liens dans les textes</span></div>
    <div class="res-chiffre"><b>{nf(lire[0].n)}</b><span>vers Wikipédia</span></div>
    <div class="res-chiffre"><b>{nf(nbAudios)}</b><span>podcasts France Culture</span></div>
    <div class="res-chiffre"><b>{nf(videos.length)}</b><span>vidéos, de {nf(nbChaines)} chaînes</span></div>
  </div>

  <h2 class="res-titre">Lire</h2>
  <div class="soc-res-list">
    {lire.map((r) => (
      <div class="soc-res-row">
        <div class="res-icone" style={`background:${r.couleur};color:${r.texte}`}>{r.icone}</div>
        <div class="soc-res-body">
          <div class="soc-res-name">{r.nom} <span class="res-n">· {nf(r.n)} liens</span></div>
          <div class="soc-res-desc">{r.desc}</div>
        </div>
        <a href={r.url} target="_blank" rel="noopener" class="parch-link soc-res-link">Visiter →</a>
      </div>
    ))}
  </div>
  <p class="res-aussi">Et aussi : {lireAussi.map((r, i) => (
    <>{i > 0 && ', '}<a href={r.url} target="_blank" rel="noopener">{r.nom}</a>{r.precision && ` (${r.precision})`} <small>{r.n}</small></>
  ))}.</p>

  <h2 class="res-titre">Écouter</h2>
  <div class="soc-res-list">
    <div class="soc-res-row">
      <div class="res-icone" style="background:#003189;color:#fff">FC</div>
      <div class="soc-res-body">
        <div class="soc-res-name">France Culture <span class="res-n">· {nf(nbAudios)} podcasts</span></div>
        <div class="soc-res-desc">Les podcasts placés en bas des fiches viennent tous de France Culture. Les émissions les plus présentes :</div>
        <ul class="res-emissions">
          {emissions.map((e) => (
            <li><span><a href={e.url} target="_blank" rel="noopener">{e.nom}</a>{e.precision && <small> · {e.precision}</small>}</span><span class="res-n">{e.n}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <h2 class="res-titre">Regarder</h2>
  <div class="soc-res-list">
    {chaines.map((c) => (
      <div class="soc-res-video">
        <div class="soc-res-video-inner">
          {c.video && (
            <div class="soc-res-vthumb soc-yt-wrap" data-ytid={c.video}>
              <img src={`https://img.youtube.com/vi/${c.video}/mqdefault.jpg`} alt={`${c.nom} : ${c.exemple}`} loading="lazy" />
              <button class="soc-res-vthumb-btn" aria-label={`Lire la vidéo de ${c.nom} sur ${c.exemple}`}><span class="soc-play-btn--sm">▶</span></button>
            </div>
          )}
          <div class="soc-res-vinfo">
            {c.logo && <img src={c.logo} alt="" loading="lazy" class="soc-res-vlogo" />}
            <div class="soc-res-vmeta">
              <div class="soc-res-vname">{c.nom} <span class="res-n">· {c.n} vidéo{c.n > 1 ? 's' : ''}</span></div>
              {c.desc && <div class="soc-res-vdesc">{c.desc}</div>}
            </div>
            <a href={c.url} target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <p class="res-aussi">Et des vidéos de médias : {medias.map((m, i) => <>{i > 0 && ', '}{m.nom} <small>{m.n}</small></>)}.</p>

  <p class="res-merci">Merci à toutes celles et ceux qui écrivent, enregistrent et filment pour partager la philosophie librement : sans eux, ce site n'existerait pas.</p>
</div>
</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/soc-widgets.js" defer></script>

</body>
</html>
