---
import Favicons from '../components/Favicons.astro';
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <title>Ressources utilisées — La Philo</title>
  <meta name="description" content="Sources et outils ayant contribué à la construction des frises et des contenus de LaPhilo.fr : Wikipédia, France Culture, Persée et chaînes YouTube de philosophie." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <a href="/" class="fha-btn" style="display:inline-block;margin-bottom:1rem;">⌂ Accueil</a>
  <h1 class="site-title">Ressources Utilisées</h1>
  <p class="site-subtitle">Sources et outils qui nourrissent LaPhilo.fr</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page">
<div class="soc-page-wrap">
  <p class="soc-res-intro">Sources et outils ayant contribué à la construction des frises et des contenus de LaPhilo.fr. Les vidéos YouTube ne se chargent qu'au clic.</p>

  <div class="soc-res-list">

    <div class="soc-res-row">
      <div class="soc-res-icon-w">W</div>
      <div class="soc-res-body">
        <div class="soc-res-name">Wikipédia</div>
        <div class="soc-res-desc">Encyclopédie libre — source principale des biographies et chronologies.</div>
      </div>
      <a href="https://fr.wikipedia.org" target="_blank" rel="noopener" class="parch-link soc-res-link">Visiter →</a>
    </div>

    <div class="soc-res-row">
      <div class="soc-res-icon-fc">FC</div>
      <div class="soc-res-body">
        <div class="soc-res-name">France Culture</div>
        <div class="soc-res-desc">Les chemins de la philosophie — podcasts de référence.</div>
      </div>
      <a href="https://www.radiofrance.fr/franceculture/podcasts/les-chemins-de-la-philosophie" target="_blank" rel="noopener" class="parch-link soc-res-link">Écouter →</a>
    </div>

    <div class="soc-res-row">
      <div class="soc-res-icon-p">P</div>
      <div class="soc-res-body">
        <div class="soc-res-name">Persée</div>
        <div class="soc-res-desc">Portail de revues et ouvrages académiques numérisés — accès libre.</div>
      </div>
      <a href="https://www.persee.fr" target="_blank" rel="noopener" class="parch-link soc-res-link">Consulter →</a>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="kw17fGL-Xdc">
          <img src="https://img.youtube.com/vi/kw17fGL-Xdc/mqdefault.jpg" alt="Parole de Philosophe" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-parolephilo.webp" alt="Parole de Philosophe" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">Parole de Philosophe</div>
            <div class="soc-res-vdesc">Toute la philosophie, accessible à tous — podcasts de philosophie.</div>
          </div>
          <a href="https://www.youtube.com/@paroledephilosophe" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="FuE8c7EZOGs">
          <img src="https://img.youtube.com/vi/FuE8c7EZOGs/mqdefault.jpg" alt="Voyages Endormis" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-voyagesendormis.webp" alt="Voyages Endormis" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">Voyages Endormis</div>
            <div class="soc-res-vdesc">Histoires et récits historiques à des fins éducatives et culturelles.</div>
          </div>
          <a href="https://www.youtube.com/@VoyagesEndormis" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="yiHMPFMCUvo">
          <img src="https://img.youtube.com/vi/yiHMPFMCUvo/mqdefault.jpg" alt="KOSMOS" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-kosmos.webp" alt="KOSMOS" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">KOSMOS</div>
            <div class="soc-res-vdesc">Faire sortir la philosophie des salles de classe — podcasts de philosophie.</div>
          </div>
          <a href="https://www.youtube.com/@Kosmos-philosophie" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="9uarj9PtCy0">
          <img src="https://img.youtube.com/vi/9uarj9PtCy0/mqdefault.jpg" alt="Philosophie Analytique" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-voyagesendormis.webp" alt="Philo analytique" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">Philosophie Analytique</div>
            <div class="soc-res-vdesc">Présentation des thèmes de la philosophie analytique, ses concepts, son histoire.</div>
          </div>
          <a href="https://www.youtube.com/@PhilosophieAnalytique" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="QUBiUR_rizA">
          <img src="https://img.youtube.com/vi/QUBiUR_rizA/mqdefault.jpg" alt="Culture Philo" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-culturephilo.webp" alt="Culture Philo" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">Culture Philo</div>
            <div class="soc-res-vdesc">Randonnée philosophique sur quelques-uns des sentiers de la réflexion.</div>
          </div>
          <a href="https://www.youtube.com/@alainbajomee" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="BJIM41TnDHI">
          <img src="https://img.youtube.com/vi/BJIM41TnDHI/mqdefault.jpg" alt="Le Précepteur" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-precepteur.webp" alt="Le Précepteur" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">Le Précepteur</div>
            <div class="soc-res-vdesc">Philosophie pour tous — podcasts de philosophie.</div>
          </div>
          <a href="https://www.youtube.com/@Le_Precepteur" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

    <div class="soc-res-video">
      <div class="soc-res-video-inner">
        <div class="soc-res-vthumb soc-yt-wrap" data-ytid="mPXQVcVkUso">
          <img src="https://img.youtube.com/vi/mPXQVcVkUso/mqdefault.jpg" alt="Vis Philo" loading="lazy" />
          <button class="soc-res-vthumb-btn" aria-label="Lire la vidéo">
            <span class="soc-play-btn--sm">▶</span>
          </button>
        </div>
        <div class="soc-res-vinfo">
          <img src="/photo/logo-visphilo.webp" alt="Vis Philo" loading="lazy" class="soc-res-vlogo" />
          <div class="soc-res-vmeta">
            <div class="soc-res-vname">Vis Philo</div>
            <div class="soc-res-vdesc">Vulgarisation des philosophes et leurs idées (anglais).</div>
          </div>
          <a href="https://www.youtube.com/@VIS_PHILOSOPHER" target="_blank" rel="noopener" class="parch-link soc-res-vlink">Voir →</a>
        </div>
      </div>
    </div>

  </div>
</div>
</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/soc-widgets.js" defer></script>

</body>
</html>
