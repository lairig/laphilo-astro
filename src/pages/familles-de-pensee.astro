---
/* Les familles de pensée et les grands débats, en arbre (composant Arbre, comme le plan du site ;
   validé le 2026-10-06) : chaque tradition › ses familles de courants (colonnes Nature, Famille,
   Issu_de des xlsx de courants) › leurs courants, avec « issu de : … » ; puis les grands débats ›
   questions › positions, avec leur description. Le nom d'une famille ou d'une question ouvre
   la Frise des courants du monde filtrée sur elle (?famille=…). */
import { getCollection } from 'astro:content';
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import Arbre from '../components/Arbre.astro';
import type { Noeud } from '../lib/arbre';
import { groupesMonde } from '../data/groupes-monde';

const courants = (await getCollection('courants')).slice().sort((a, b) => a.data.year - b.data.year);
const an = (y: number) => (y < 0 ? `${-y} av. J.-C.` : String(y));
const lienFrise = (f: string) => `/frises/courants-du-monde/?famille=${encodeURIComponent(f)}`;
const issu = (c: (typeof courants)[number]) => (c.data.issu_de?.length ? `issu de : ${c.data.issu_de.join(', ')}` : undefined);

const parFamille = new Map<string, typeof courants>();
for (const c of courants) {
  if (!c.data.famille) continue;
  if (!parFamille.has(c.data.famille)) parFamille.set(c.data.famille, []);
  parFamille.get(c.data.famille)!.push(c);
}
/* Une famille de mouvements est rangée dans la tradition de la majorité de ses courants */
const familles = [...parFamille.entries()].filter(([, m]) => m[0].data.nature === 'mouvement').map(([nom, m]) => {
  const compte = new Map<string, number>();
  m.forEach((c) => compte.set(c.data.groupe ?? '', (compte.get(c.data.groupe ?? '') ?? 0) + 1));
  return { nom, membres: m, tradition: [...compte.entries()].sort((a, b) => b[1] - a[1])[0][0] };
});
const debats = [...parFamille.entries()].filter(([, m]) => m[0].data.nature === 'position')
  .sort((a, b) => a[1][0].data.year - b[1][0].data.year);

const racine: Noeud = {
  label: 'Les familles de pensée', ouvert: true,
  enfants: [
    ...groupesMonde.map((g) => {
      const fs = familles.filter((f) => f.tradition === g.id).sort((a, b) => a.membres[0].data.year - b.membres[0].data.year);
      return {
        label: g.label, id: g.id, ouvert: true, note: `${fs.length} famille${fs.length > 1 ? 's' : ''}`,
        enfants: fs.map((f) => ({
          label: f.nom, href: lienFrise(f.nom),
          note: `${an(f.membres[0].data.year)} → ${an(f.membres[f.membres.length - 1].data.year)} · ${f.membres.length} courants`,
          enfants: f.membres.map((c) => ({ label: c.data.name, href: `/courants/${c.id}/`, note: c.data.display_date, detail: issu(c), fiche: true })),
        })),
      };
    }).filter((t) => t.enfants.length),
    {
      label: 'Les grands débats', id: 'debats', ouvert: true, note: `${debats.length} questions`,
      enfants: debats.map(([q, positions]) => ({
        label: q, href: lienFrise(q), note: `${positions.length} réponses`,
        enfants: positions.map((p) => ({
          label: p.data.name, href: `/courants/${p.id}/`,
          detail: p.data.description ? p.data.description.charAt(0).toUpperCase() + p.data.description.slice(1).replace(/\.$/, '') : undefined, fiche: true,
        })),
      })),
    },
  ],
};

const nbFamilles = familles.length;
const title = 'Familles de pensée et grands débats | LaPhilo.fr';
const description = `Les courants de pensée du monde rangés en ${nbFamilles} familles, de la Grèce à l'Inde et à la Chine, et les grandes questions qui les opposent.`;
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead
    title={title}
    description={description}
    path="/familles-de-pensee/"
    ariane={[['Les courants de pensée', '/histoire-des-courants/'], ['Familles de pensée', '/familles-de-pensee/']]}
  />
  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css?v=20261001" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Les familles de pensée</h1>
  <p class="site-subtitle">Filiations et grands débats</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page def-page">
  <div class="intro-text-col">
    <p class="intro-drop-cap">Aucun courant de pensée ne naît seul. Le stoïcisme hérite du cynisme, le marxisme des jeunes hégéliens, le zen du bouddhisme du Grand Véhicule et du taoïsme. Pour s'y retrouver parmi les {courants.length} courants du site, on peut les ranger en {nbFamilles} <strong>familles</strong>, des lignées d'écoles qui se répondent, se prolongent ou se combattent.</p>
    <p class="intro-body">D'autres « -ismes » ne sont pas des écoles mais des <strong>réponses</strong> qu'on retrouve à toutes les époques : on est moniste ou dualiste, déterministe ou partisan du libre arbitre, depuis l'Antiquité. Ils sont rassemblés à la fin de l'arbre, autour des {debats.length} <a href="#debats">grands débats</a> qui les opposent.</p>
    <p class="intro-body">Ouvrez une famille pour voir ses courants et d'où ils viennent. Le nom d'une famille ou d'une question ouvre la <a href="/frises/courants-du-monde/">Frise des courants du monde</a>, où l'on voit, en choisissant un courant, d'où il vient et ce qu'il a fait naître.</p>
  </div>
</main>

<Arbre racine={racine} label="Familles de pensée et grands débats" placeholder="Chercher une famille, un courant ou une question…" />

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>

</body>
</html>
