<script is:inline>
  /* Ondes animées du cartouche France Culture pendant la lecture */
  document.querySelectorAll('.bv-podcast audio').forEach(function (a) {
    var c = a.closest('.bv-podcast');
    a.addEventListener('play', function () { c.classList.add('en-lecture'); });
    ['pause', 'ended'].forEach(function (ev) { a.addEventListener(ev, function () { c.classList.remove('en-lecture'); }); });
  });
</script>

