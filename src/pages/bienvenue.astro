---
/* « Nouveau ici ? » : présentation du site et mode d'emploi, avec un parcours
   conseillé et tous les principaux liens. Cible du bouton « Nouveau ici » de
   l'accueil. */
import { getCollection } from 'astro:content';
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import catalogue from '../data/frises-catalogue.json';

const philosophes = await getCollection('philosophes');
const courants = await getCollection('courants');

type Lien = { href: string; titre: string; texte: string };

/* Parcours conseillé, dans l'ordre */
const parcours: Lien[] = [
  { href: '/definition/', titre: "C'est quoi la philosophie ?", texte: 'Les sept grandes branches : métaphysique, éthique, politique, logique… Le meilleur point de départ.' },
  { href: '/histoire-des-courants/', titre: 'Les courants de pensée', texte: 'Stoïcisme, bouddhisme, Lumières, existentialisme… les grandes familles d’idées et leurs filiations.' },
  { href: '/philosophes-d-aujourd-hui/', titre: "Les philosophes d'aujourd'hui", texte: 'Les penseurs vivants, par sujet de travail et par région du monde.' },
  { href: '/histoire-des-philosophes/', titre: 'L’histoire des philosophes', texte: 'Les grandes figures, des présocratiques à nos jours et sur tous les continents, présentées époque par époque.' },
  { href: '/frises/', titre: 'Les frises chronologiques', texte: 'Le cœur du site : chaque penseur situé dans son époque, par pays, par tradition ou par courant.' },
];

/* Tous les principaux liens, par rubrique (mêmes libellés que le plan du site) */
const rubriques: { titre: string; liens: Lien[] }[] = [
  {
    titre: 'Comprendre',
    liens: [
      { href: '/definition/', titre: "C'est quoi ?", texte: 'Les 7 branches' },
      { href: '/histoire-des-philosophes/', titre: 'L’histoire des philosophes', texte: 'Les grandes figures' },
      { href: '/philosophes-d-aujourd-hui/', titre: "Les philosophes d'aujourd'hui", texte: 'Les penseurs vivants' },
      { href: '/histoire-des-courants/', titre: 'Les courants de pensée', texte: 'Les familles d’idées' },
    ],
  },
  {
    titre: 'Frise du monde',
    liens: [
      { href: '/frises/penseurs-du-monde/', titre: 'Penseurs du monde', texte: 'Frise et tableau des penseurs' },
      { href: '/frises/courants-du-monde/', titre: 'Pensées du monde', texte: 'Frise et tableau des courants' },
      { href: '/frises/penseurs-du-monde/?femmes=1', titre: 'Les femmes dans l’histoire', texte: 'Les penseuses du monde entier' },
    ],
  },
  {
    titre: 'Trouver',
    liens: [
      { href: '/recherche/', titre: 'Recherche', texte: 'Philosophes, courants, frises' },
      { href: '/frises/', titre: 'Toutes les frises', texte: 'Par époque, pays, tradition' },
      { href: '/philosophes/frise/femmes-toutes-epoques/', titre: 'Pensée féminine', texte: 'Les philosophes femmes' },
      { href: '/plan-du-site/', titre: 'Plan du site', texte: 'Toutes les pages et frises' },
    ],
  },
  {
    titre: 'À propos',
    liens: [
      { href: '/pourquoi/', titre: 'Pourquoi ce site', texte: 'La genèse du projet' },
      { href: '/ressources/', titre: 'Ressources utilisées', texte: 'Sources et références' },
      { href: '/echanges/', titre: 'Échanges & contact', texte: 'Écrire, proposer' },
      { href: '/lairig/', titre: 'Musique Lairig', texte: "L'autre face du projet" },
    ],
  },
];

/* Vidéo YouTube et podcast France Culture de la présentation. À remplir :
   ytId = la partie après « v= » dans l'adresse YouTube ;
   podcast.src = adresse du fichier .mp3 (radiofrance-podcast.net), podcast.titre = titre de l'émission.
   Tant qu'un champ est vide, son bloc n'apparaît pas sur le site (un emplacement est montré en local). */
const media = {
  ytId: 'tSeNdAwn5Hc',
  ytTitre: 'L’histoire de la philosophie en 5 minutes (Le philosophe)',
  podcast: {
    src: 'https://media.radiofrance-podcast.net/podcast09/26835-27.09.2026-ITEMA_24688390-2026F4170S0270-NET_MFI_0FE428CA-1B56-4195-96A7-33F9A6F70853-27-1ce14113cd570598717fbf8d39b97981.m4a',
    titre: 'En quoi croyons-nous ?',
  },
};
const dev = import.meta.env.DEV;

/* Chiffres calculés : grandes traditions = groupes de la Frise des penseurs du
   monde qui ont au moins une fiche ; frises = toutes les frises du catalogue (/frises/) */
const nbTraditions = new Set(philosophes.map((p) => p.data.groupe).filter(Boolean)).size;
const nbFrises = (catalogue.groups as any[]).reduce((n, g) =>
  n + g.items.reduce((m: number, it: any) => m + (it.href ? 1 : 0) + (it.links || []).filter((l: any) => !l.href.includes('?')).length, 0), 0);

const title = 'Bienvenue sur LaPhilo.fr : par où commencer en philosophie';
const description = `Mode d'emploi de LaPhilo.fr : ${philosophes.length} philosophes et ${courants.length} courants de toutes les traditions, des frises interactives et un parcours pour bien commencer.`;
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead title={title} description={description} path="/bienvenue/" ariane={[['Bienvenue', '/bienvenue/']]} />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    .bv { max-width: 920px; margin: 0 auto; padding: 0 1.5rem 3rem; }
    .bv-titre {
      margin: 2.6rem 0 1rem; text-align: center;
      font-family: 'Cinzel', serif; font-size: .85rem; font-weight: 400; letter-spacing: .2em; text-transform: uppercase;
      color: var(--gold-light, #d4a843); text-shadow: 0 1px 12px rgba(180, 130, 20, .35);
    }
    .bv-titre::before, .bv-titre::after { content: ' ✦ '; }

    /* Présentation : parchemin, comme le cartouche d'introduction de l'accueil */
    .bv-parch {
      position: relative; overflow: hidden;
      padding: 1.6rem 2rem 1.4rem;
      background: linear-gradient(150deg, #f7efcc 0%, #ead8a0 45%, #e0cb8a 100%), var(--noise);
      border: 1px solid var(--parch-border, #b8923c); border-radius: var(--radius, 6px);
      box-shadow: 5px 5px 0 rgba(120, 80, 20, .2), 0 16px 48px rgba(10, 5, 2, .5);
    }
    .bv-parch::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; opacity: .6;
      background: linear-gradient(90deg, transparent, var(--gold, #b8860b), var(--rust, #8b3a0f), var(--gold, #b8860b), transparent);
    }
    .bv-parch p { font-family: 'EB Garamond', serif; font-size: 1.05rem; line-height: 1.7; color: var(--ink-mid, #3d2410); text-align: justify; }
    .bv-parch p + p { margin-top: .7rem; }
    .bv-lettrine::first-letter {
      font-family: 'Cinzel Decorative', serif; font-size: 3.2rem; font-weight: 700; color: var(--rust, #8b3a0f);
      float: left; line-height: .8; margin: .08em .12em 0 0;
    }
    .bv-chiffres { display: flex; justify-content: center; flex-wrap: wrap; gap: .6rem 2rem; margin-top: 1.2rem; padding-top: 1rem;
      border-top: 1px solid rgba(180, 130, 50, .3); }
    .bv-chiffres span { font-family: 'Cinzel', serif; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--rust, #8b3a0f); text-align: center; }
    .bv-chiffres b { display: block; font-family: 'Cinzel Decorative', serif; font-size: 1.6rem; color: var(--ink, #1e1208); letter-spacing: 0; }

    /* Vidéo + podcast sous la présentation : côte à côte, empilés sur mobile */
    .bv-media { display: grid; grid-template-columns: 3fr 2fr; gap: 1rem; margin-top: 1.4rem; align-items: stretch; }
    .bv-media:has(> :only-child) { grid-template-columns: 1fr; max-width: 640px; margin-left: auto; margin-right: auto; }
    .bv-video, .bv-podcast { border: 1px solid rgba(212, 168, 67, .4); border-radius: 6px; overflow: hidden; background: rgba(30, 18, 8, .75); }
    .bv-video .youtube-container { aspect-ratio: 16 / 9; }
    .bv-media-legende { margin: 0; padding: .45rem .8rem; font-family: 'EB Garamond', serif; font-style: italic; font-size: .95rem; color: #ead9a8; }
    /* Podcast : aux couleurs violettes de France Culture */
    .bv-podcast {
      display: flex; flex-direction: column; justify-content: center; gap: .9rem; padding: 1.3rem 1.3rem 1.2rem;
      background: radial-gradient(circle at 85% 10%, rgba(214, 92, 196, .28), transparent 55%), linear-gradient(160deg, #4a1645 0%, #2a0d28 60%, #1c0a1a 100%);
      border: 1px solid rgba(214, 120, 200, .45); border-top: 3px solid #c94fb8;
    }
    .bv-fc-tete { display: flex; align-items: center; gap: .8rem; }
    .bv-fc-ondes { flex: none; display: flex; align-items: center; justify-content: center; gap: 3px; width: 2.9rem; height: 2.9rem; border-radius: 50%;
      background: #c94fb8; box-shadow: 0 0 0 4px rgba(201, 79, 184, .25); }
    .bv-fc-ondes i { display: block; width: 3px; border-radius: 2px; background: #fff; height: 40%; }
    .bv-fc-ondes i:nth-child(2), .bv-fc-ondes i:nth-child(4) { height: 65%; }
    .bv-fc-ondes i:nth-child(3) { height: 85%; }
    .bv-podcast.en-lecture .bv-fc-ondes i { animation: bv-onde .9s ease-in-out infinite alternate; }
    .bv-podcast.en-lecture .bv-fc-ondes i:nth-child(2n) { animation-delay: -.45s; }
    .bv-podcast.en-lecture .bv-fc-ondes i:nth-child(3) { animation-delay: -.2s; }
    @keyframes bv-onde { from { height: 25%; } to { height: 90%; } }
    @media (prefers-reduced-motion: reduce) { .bv-podcast.en-lecture .bv-fc-ondes i { animation: none; } }
    .bv-fc-marque { display: flex; flex-direction: column; line-height: 1.15; }
    .bv-fc-marque b { font-family: 'Cinzel', serif; font-size: 1.05rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #fff; }
    .bv-fc-marque small { font-family: 'EB Garamond', serif; font-size: .95rem; font-style: italic; color: #e6b3dc; }
    .bv-podcast-titre { margin: 0; font-family: 'EB Garamond', serif; font-size: 1.1rem; line-height: 1.4; color: #f6e6f2; }
    .bv-podcast audio { width: 100%; border-radius: 999px; }
    .bv-vide { display: grid; place-items: center; min-height: 160px; padding: 1rem; text-align: center; border-style: dashed;
      font-family: 'EB Garamond', serif; font-size: 1rem; color: #c9a96e; }
    .bv-vide small { font-size: .8rem; opacity: .8; }

    /* Parcours conseillé : étapes numérotées */
    .bv-parcours { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; counter-reset: etape; }
    .bv-etape a {
      display: flex; align-items: center; gap: 1rem; padding: .9rem 1.1rem; text-decoration: none;
      background: rgba(30, 18, 8, .75); border: 1px solid rgba(212, 168, 67, .4); border-radius: 6px;
      transition: transform .2s, border-color .2s, background .2s;
    }
    .bv-etape a:hover, .bv-etape a:focus-visible { transform: translateX(4px); border-color: #d4a843; background: rgba(60, 36, 12, .85); outline: none; }
    .bv-num {
      flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center;
      font-family: 'Cinzel Decorative', serif; font-weight: 700; font-size: 1.05rem; color: var(--ink, #1e1208);
      background: linear-gradient(150deg, #f3dc92 0%, #d4a843 55%, #b8860b 100%); border: 1px solid #e8c870;
    }
    .bv-etape-txt { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
    .bv-etape-txt strong { font-family: 'Cinzel', serif; font-size: .92rem; letter-spacing: .04em; color: #f7ecce; }
    .bv-etape-txt span { font-family: 'EB Garamond', serif; font-size: 1rem; line-height: 1.35; color: #ead9a8; font-style: italic; }
    .bv-fleche { margin-left: auto; flex: none; color: #d4a843; font-size: 1.1rem; }

    /* Mode d'emploi des frises */
    .bv-mode { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .8rem; }
    .bv-astuce { padding: 1rem 1.1rem; background: rgba(30, 18, 8, .6); border: 1px solid rgba(212, 168, 67, .25); border-top: 3px solid #d4a843; border-radius: 6px; }
    .bv-astuce b { display: block; font-family: 'Cinzel', serif; font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: #d4a843; margin-bottom: .35rem; }
    .bv-astuce p { font-family: 'EB Garamond', serif; font-size: 1rem; line-height: 1.45; color: #ead9a8; }

    /* Tous les liens */
    .bv-liens { display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 1rem; align-items: start; }
    .bv-rub { padding: 1rem 1.1rem .8rem; background: rgba(30, 18, 8, .75); border: 1px solid rgba(212, 168, 67, .35); border-radius: 6px; }
    .bv-rub h3 { margin: 0 0 .4rem; padding-bottom: .4rem; border-bottom: 1px solid rgba(212, 168, 67, .3);
      font-family: 'Cinzel', serif; font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #d4a843; }
    .bv-rub ul { list-style: none; margin: 0; padding: 0; }
    .bv-rub li + li { border-top: 1px solid rgba(212, 168, 67, .1); }
    .bv-rub a { display: flex; flex-direction: column; padding: .45rem .2rem; text-decoration: none; }
    .bv-rub a strong { font-family: 'EB Garamond', serif; font-size: 1.08rem; font-weight: 500; color: #f7ecce; }
    .bv-rub a span { font-family: 'EB Garamond', serif; font-size: .9rem; font-style: italic; color: #c9a96e; }
    .bv-rub a:hover strong, .bv-rub a:focus-visible strong { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
    .bv-rub a:focus-visible { outline: none; background: rgba(180, 130, 20, .15); }

    .bv-fin { margin-top: 2.4rem; text-align: center; }
    .bv-cta {
      display: inline-block; padding: .7rem 1.6rem; border-radius: 4px; text-decoration: none;
      font-family: 'Cinzel', serif; font-size: .82rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      color: var(--ink, #1e1208); background: linear-gradient(150deg, #f3dc92 0%, #d4a843 55%, #b8860b 100%); border: 1px solid #e8c870;
    }
    .bv-cta:hover { filter: brightness(1.08); }

    @media (max-width: 600px) {
      .bv { padding: 0 1rem 2.5rem; }
      .bv-parch { padding: 1.2rem 1.1rem 1.1rem; }
      .bv-parch p { font-size: 1rem; text-align: left; }
      .bv-lettrine::first-letter { font-size: 2.4rem; }
      .bv-chiffres { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem 1rem; }
      .bv-chiffres b { font-size: 1.3rem; }
      .bv-media { grid-template-columns: 1fr; }
      .bv-etape a { padding: .8rem .8rem; gap: .8rem; }
      .bv-fleche { display: none; }
      .bv-rub a { padding: .6rem .2rem; }
    }
  </style>
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/plan-du-site/" class="sitemap-btn">
      <span class="sitemap-flag" aria-hidden="true">≡</span>
      <span class="sitemap-text">Plan du site</span>
    </a>
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Bienvenue</h1>
  <p class="site-subtitle">Nouveau ici · Présentation du site</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="bv">

  <section class="bv-parch" aria-label="Présentation">
    <p class="bv-lettrine">LaPhilo.fr est une invitation à voyager dans l'histoire de la pensée, sans prérequis. Pas un cours magistral : un lieu où l'on peut flâner, d'un penseur à l'autre, d'une époque à l'autre, d'une culture à l'autre.</p>
    <p>Le site réunit les philosophes et les courants de pensée de toutes les traditions : la Grèce et l'Occident, mais aussi le monde islamique et juif, l'Inde, la Chine et le Japon, l'Afrique et les Amériques, la Russie, jusqu'aux sagesses de l'Égypte et de la Mésopotamie. Chacun est présenté par un court texte, souvent accompagné d'une vidéo ou d'un podcast, et situé sur des frises chronologiques interactives pour voir qui a pensé quoi, quand, et en dialogue avec qui.</p>
    <p>Car la philosophie ne s'est jamais pensée seule. Socrate, le Bouddha et Confucius ont vécu à la même époque sans se connaître ; Averroès a transmis Aristote à l'Europe latine ; les Lumières ont lu les sages chinois, et la pensée africaine dialogue aujourd'hui avec celle de Paris ou de New York. Les frises rendent ces rencontres visibles : on y découvre des contemporains inattendus, des filiations, des ruptures.</p>
    <p>Le site fait aussi une place à celles et ceux que les manuels oublient souvent : les femmes philosophes, d'Enheduanna à Simone de Beauvoir et Hannah Arendt, et les penseurs vivants, en France et dans le monde, classés par région et par sujet de travail : l'intelligence artificielle, l'écologie, la justice, le genre, la décolonisation, le sens de l'existence…</p>
    <div class="bv-chiffres">
      <span><b>{philosophes.length}</b>philosophes</span>
      <span><b>{courants.length}</b>courants de pensée</span>
      <span><b>{nbFrises}</b>frises</span>
      <span><b>{nbTraditions}</b>grandes traditions</span>
    </div>
  </section>

  {(media.ytId || media.podcast.src || dev) && (
    <section class="bv-media" aria-label="Écouter et regarder">
      {media.ytId ? (
        <div class="bv-video">
          <div class="youtube-container" data-id={media.ytId}>
            <img src={`https://img.youtube.com/vi/${media.ytId}/hqdefault.jpg`} alt={`Vidéo : ${media.ytTitre || 'présentation'}`} loading="lazy" width="480" height="360" />
            <button class="play-button" aria-label={`Lancer la vidéo : ${media.ytTitre || 'présentation'}`}></button>
          </div>
          {media.ytTitre && <p class="bv-media-legende">{media.ytTitre}</p>}
        </div>
      ) : dev && <div class="bv-video bv-vide">Emplacement de la vidéo YouTube<br /><small>(renseigner media.ytId — visible seulement en local)</small></div>}
      {media.podcast.src ? (
        <div class="bv-podcast">
          <div class="bv-fc-tete">
            <span class="bv-fc-ondes" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <span class="bv-fc-marque"><b>France Culture</b><small>Podcast · à écouter</small></span>
          </div>
          <p class="bv-podcast-titre">{media.podcast.titre || 'Prolonger la découverte à l’écoute d’une émission de France Culture.'}</p>
          <audio controls preload="none" title={media.podcast.titre || 'Podcast France Culture'}>
            <source src={media.podcast.src} type={media.podcast.src.endsWith('.m4a') ? 'audio/mp4' : 'audio/mpeg'} />
          </audio>
        </div>
      ) : dev && <div class="bv-podcast bv-vide">Emplacement du podcast France Culture<br /><small>(renseigner media.podcast — visible seulement en local)</small></div>}
    </section>
  )}

  <h2 class="bv-titre">Par où commencer</h2>
  <ol class="bv-parcours">
    {parcours.map((e, i) => (
      <li class="bv-etape">
        <a href={e.href}>
          <span class="bv-num" aria-hidden="true">{i + 1}</span>
          <span class="bv-etape-txt"><strong>{e.titre}</strong><span>{e.texte}</span></span>
          <span class="bv-fleche" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>

  <h2 class="bv-titre">Comment lire une frise</h2>
  <div class="bv-mode">
    <div class="bv-astuce"><b>Faire défiler</b><p>Chaque frise présente ses penseurs dans l'ordre du temps : avancez avec les flèches, le doigt ou la souris.</p></div>
    <div class="bv-astuce"><b>Lire une fiche</b><p>Un texte de présentation, avec ses liens vers Wikipédia et les œuvres, une vidéo ou un podcast à lancer d'un clic.</p></div>
    <div class="bv-astuce"><b>Rebondir</b><p>Sous chaque fiche, les courants de pensée mènent à leur propre frise : on passe ainsi d'une idée à une autre.</p></div>
    <div class="bv-astuce"><b>Chercher</b><p>La recherche trouve un philosophe, un courant ou une frise, avec des filtres par époque, pays ou tradition.</p></div>
  </div>

  <h2 class="bv-titre">Tous les liens pour naviguer</h2>
  <div class="bv-liens">
    {rubriques.map((r) => (
      <section class="bv-rub">
        <h3>{r.titre}</h3>
        <ul>
          {r.liens.map((l) => (
            <li><a href={l.href}><strong>{l.titre}</strong><span>{l.texte}</span></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="bv-fin">
    <a class="bv-cta" href="/definition/">Commencer le voyage →</a>
  </div>

</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
