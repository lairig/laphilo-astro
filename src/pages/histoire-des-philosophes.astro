---
import data from '../data/definition-philosophes.json';

const { intro, items } = data as {
  intro: string;
  items: { name: string; tag: string; ytId: string | null; text: string }[];
};

const westernCount = 13;
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Histoire des philosophes : des présocratiques à aujourd'hui — La Philo</title>
  <meta name="description" content="Des présocratiques grecs aux penseurs contemporains, occidentaux et non-occidentaux : l'histoire de la philosophie racontée par grandes périodes et traditions." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <a href="/" class="fha-btn" style="display:inline-block;margin-bottom:1rem;">⌂ Accueil</a>
  <h1 class="site-title">Les Philosophes</h1>
  <p class="site-subtitle">Des présocratiques grecs aux penseurs contemporains</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page">
  <div class="intro-text-col" set:html={intro} />

  <div class="drawer-intro-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">✦</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <div class="definition-section-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">Philosophes occidentaux</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <div class="acc-list">
    {items.slice(0, westernCount).map((it) => (
      <div class="acc-item">
        <button class="acc-toggle" aria-expanded="false" type="button">
          <span class="acc-name">{it.name}</span>
          <span class="acc-date" set:html={it.tag} />
          <span class="acc-chevron" aria-hidden="true">▶</span>
        </button>
        <div class="acc-content">
          {it.ytId && (
            <div class="acc-video">
              <div class="youtube-container" data-id={it.ytId}>
                <img src={`https://img.youtube.com/vi/${it.ytId}/hqdefault.jpg`} alt={`Vidéo : ${it.name}`} loading="lazy" width="480" height="360" />
                <button class="play-button" aria-label={`Lancer la vidéo : ${it.name}`}></button>
              </div>
            </div>
          )}
          <div class="acc-text" set:html={it.text} />
        </div>
      </div>
    ))}
  </div>

  <div class="definition-section-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">Philosophes non-occidentaux</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <div class="acc-list">
    {items.slice(westernCount).map((it) => (
      <div class="acc-item">
        <button class="acc-toggle" aria-expanded="false" type="button">
          <span class="acc-name">{it.name}</span>
          <span class="acc-date" set:html={it.tag} />
          <span class="acc-chevron" aria-hidden="true">▶</span>
        </button>
        <div class="acc-content">
          {it.ytId && (
            <div class="acc-video">
              <div class="youtube-container" data-id={it.ytId}>
                <img src={`https://img.youtube.com/vi/${it.ytId}/hqdefault.jpg`} alt={`Vidéo : ${it.name}`} loading="lazy" width="480" height="360" />
                <button class="play-button" aria-label={`Lancer la vidéo : ${it.name}`}></button>
              </div>
            </div>
          )}
          <div class="acc-text" set:html={it.text} />
        </div>
      </div>
    ))}
  </div>
</main>

<script src="/js/home-main.js" defer></script>
<script src="/js/accordion.js" defer></script>

</body>
</html>
