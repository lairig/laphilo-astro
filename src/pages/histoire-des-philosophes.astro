---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import Voyage from '../components/Voyage.astro';
import CartoucheMonde from '../components/CartoucheMonde.astro';
import data from '../data/definition-philosophes.json';

const { intro, items } = data as {
  intro: string;
  items: { name: string; tag: string; ytId: string | null; text: string }[];
};

/* Introduction : mêmes styles que /definition/ (lettrine, texte justifié) au lieu des styles en ligne du JSON */
const introHtml = intro
  .replace(/\s*style="[^"]*"/g, '')
  .replace('<p>', '<p class="intro-drop-cap">')
  .replaceAll('<p>', '<p class="intro-body">');

/* Les anciens boutons « Frise des … → » en fin de texte sont retirés : leurs liens
   (frise ouverte sur le premier philosophe de la période, ?p=) passent dans le bloc
   « Explorer sur LaPhilo.fr », sous des libellés plus courts. */
const ANCIEN_BOUTON = /(?:\s*<br\s*\/?>)*\s*<p class="ldl-li"[^>]*>[\s\S]*?<\/p>/g;
const textes = items.map((it) => ({ ...it, text: it.text.replace(ANCIEN_BOUTON, '').trim() }));

/* Les cartouches rangés par grande tradition, comme /histoire-des-courants/ ; l'Occident découpé en époques.
   Chaque cartouche du JSON doit figurer une fois et une seule (vérifié au build). */
type Tradition = { id: string; titre: string; nav: string; chapeau: string; groupes: { titre?: string; cartes: string[] }[] };
const TRADITIONS: Tradition[] = [
  {
    id: 'orient-ancien', titre: 'Le Proche-Orient ancien', nav: 'Orient ancien',
    chapeau: 'Égypte, Mésopotamie et Iran : les premiers sages dont l’histoire a retenu le nom.',
    groupes: [{ cartes: ['Le Proche-Orient ancien'] }],
  },
  {
    id: 'occident', titre: 'L’Occident', nav: 'Occident',
    chapeau: 'Des présocratiques grecs aux penseurs du XXIᵉ siècle, les grandes périodes de la philosophie occidentale.',
    groupes: [
      { titre: 'L’Antiquité', cartes: ['Les présocratiques', 'La Grèce classique', 'La période hellénistique', 'Rome', 'L’Antiquité tardive'] },
      { titre: 'Le Moyen Âge', cartes: ['Le haut Moyen Âge', 'La scolastique', 'La fin du Moyen Âge'] },
      { titre: 'Les Temps modernes', cartes: ['La Renaissance et l’humanisme', 'Rationalistes et empiristes', 'Les Lumières'] },
      { titre: 'XIX<sup>e</sup> – XXI<sup>e</sup> siècle', cartes: ['Le XIXᵉ siècle', 'Le XXᵉ siècle', 'Le XXIᵉ siècle'] },
    ],
  },
  {
    id: 'inde', titre: 'L’Inde', nav: 'Inde',
    chapeau: 'Du Bouddha et de Shankara à Gandhi et Ambedkar : le Soi, la souffrance et la libération.',
    groupes: [{ cartes: ['L’Inde ancienne et classique', 'L’Inde moderne'] }],
  },
  {
    id: 'asie-est', titre: 'L’Asie de l’Est', nav: 'Asie de l’Est',
    chapeau: 'Chine, Corée et Japon : de Confucius et Laozi à l’école de Kyōto.',
    groupes: [{ cartes: ['La Chine classique', 'La Corée', 'Le Japon'] }],
  },
  {
    id: 'islam-juif', titre: 'L’Islam et la pensée juive', nav: 'Islam et judaïsme',
    chapeau: 'De Bagdad à Cordoue, du Caire à Lahore : la raison face à la révélation, d’al-Kindi à Levinas.',
    groupes: [{ cartes: ['L’âge d’or de la pensée islamique', 'L’islam moderne', 'La pensée juive'] }],
  },
  {
    id: 'russie', titre: 'La Russie', nav: 'Russie',
    chapeau: 'De Tchaadaïev à Bakhtine, une pensée passionnée par la question de son propre destin.',
    groupes: [{ cartes: ['La Russie'] }],
  },
  {
    id: 'afrique-ameriques', titre: 'L’Afrique et les Amériques', nav: 'Afrique et Amériques',
    chapeau: 'Des sages d’Éthiopie et du Mexique ancien aux penseurs de la décolonisation.',
    groupes: [{ cartes: ['L’Afrique', 'Les Amériques et les Caraïbes'] }],
  },
];
{
  const places = TRADITIONS.flatMap((t) => t.groupes.flatMap((g) => g.cartes));
  const noms = items.map((it) => it.name);
  const manquants = noms.filter((n) => !places.includes(n));
  const inconnus = places.filter((n) => !noms.includes(n));
  const doubles = places.filter((n, i) => places.indexOf(n) !== i);
  if (manquants.length || inconnus.length || doubles.length)
    throw new Error(`histoire-des-philosophes : cartouches non rangés ${manquants}, inconnus ${inconnus}, en double ${doubles}`);
}
const carte = (nom: string) => textes.find((t) => t.name === nom)!;

/* Bloc « Explorer » : le premier lien est le bouton principal ; la Frise des
   penseurs du monde s'ouvre dans un nouvel onglet */
type Lien = { href: string; label: string; monde?: boolean };
const frise = (slug: string, p?: string) => `/philosophes/frise/${slug}/${p ? `?p=${encodeURIComponent(p)}` : ''}`;
const M = {
  axial: { href: '/frises/penseurs-du-monde/?periode=age-axial', label: 'Frise du monde : Âge axial', monde: true },
  orIslam: { href: '/frises/penseurs-du-monde/?periode=age-d-or-islamique', label: 'Frise du monde : Âge d’or islamique', monde: true },
  xix: { href: '/frises/penseurs-du-monde/?periode=xixe-siecle', label: 'Frise du monde : XIXᵉ siècle', monde: true },
  tout: { href: '/frises/penseurs-du-monde/', label: 'Frise des penseurs du monde', monde: true },
};
const EXPLORER: Record<string, Lien[]> = {
  'Le Proche-Orient ancien': [{ href: frise('proche-orient-ancien-toutes-epoques', 'IMHOTEP'), label: 'Le Proche-Orient ancien sur la frise' }],
  'Les présocratiques': [{ href: frise('greco-romains', 'PITTACOS de Mytilène'), label: 'Les présocratiques sur la frise' }, M.axial],
  'La Grèce classique': [{ href: frise('greco-romains', 'GORGIAS'), label: 'Les classiques grecs sur la frise' }, M.axial],
  'La période hellénistique': [{ href: frise('greco-romains', 'CRATÈS de Thèbes'), label: 'La période hellénistique sur la frise' }],
  'Rome': [{ href: frise('greco-romains', "POSIDONIOS d'Apamée"), label: 'L’Antiquité romaine sur la frise' }],
  'L’Antiquité tardive': [{ href: frise('greco-romains', 'PLOTIN'), label: 'L’Antiquité tardive sur la frise' }],
  'Le haut Moyen Âge': [{ href: frise('medievaux', "DENYS L'Aéropagite"), label: 'Le haut Moyen Âge sur la frise' }, M.orIslam],
  'La scolastique': [{ href: frise('medievaux', "GERBERT d'Aurillac"), label: 'La scolastique sur la frise' }, M.orIslam],
  'La fin du Moyen Âge': [{ href: frise('medievaux', 'Thierry de FREIBERG'), label: 'La fin du Moyen Âge sur la frise' }],
  'La Renaissance et l’humanisme': [{ href: frise('renaissance-lumieres', 'Jean PIC de la Mirandole'), label: 'La Renaissance sur la frise' }],
  'Rationalistes et empiristes': [{ href: frise('renaissance-lumieres', 'Thomas HOBBES'), label: 'Rationalistes et empiristes sur la frise' }],
  'Les Lumières': [{ href: frise('renaissance-lumieres', 'MONTESQUIEU'), label: 'Les Lumières sur la frise' }],
  'Le XIXᵉ siècle': [
    { href: frise('allemands', 'Frédéric HEGEL'), label: 'Le XIXᵉ siècle sur la frise' },
    { href: frise('france', 'Charles FOURIER'), label: 'Penseurs français' },
    { href: frise('americains', 'Ralph Waldo EMERSON'), label: 'Penseurs américains' },
    { href: frise('modernes', 'Karl Leonhard REINHOLD'), label: 'Autres pays' },
    M.xix,
  ],
  'Le XXᵉ siècle': [
    { href: frise('occident-xxe-aujourdhui', 'Edmund HUSSERL'), label: 'Le XXᵉ siècle sur la frise' },
    { href: frise('france', 'Henri BERGSON'), label: 'Penseurs français' },
    { href: frise('allemands', 'Edmund HUSSERL'), label: 'Penseurs allemands' },
  ],
  'Le XXIᵉ siècle': [
    { href: '/philosophes-d-aujourd-hui/', label: 'Les philosophes d’aujourd’hui, par sujet et par région' },
    { href: frise('france-contemporains', 'Pierre MAGNARD'), label: 'Penseurs français actuels' },
    { href: frise('contemporains-europe'), label: 'Europe' },
    { href: frise('contemporains-ameriques'), label: 'Amériques' },
    { href: frise('contemporains-afrique-moyen-orient'), label: 'Afrique & Moyen-Orient' },
    { href: frise('contemporains-asie-oceanie'), label: 'Asie & Océanie' },
    { href: frise('contemporains-monde', 'Hermann LUBBE'), label: 'Monde entier' },
  ],
  'L’Inde ancienne et classique': [{ href: frise('inde-bouddhisme-toutes-epoques', 'Siddharta GAUTAMA'), label: 'Les philosophes de l’Inde sur la frise' }, M.axial],
  'L’Inde moderne': [{ href: frise('inde-bouddhisme-toutes-epoques', 'Râm Mohan ROY'), label: 'L’Inde moderne sur la frise' }, M.xix],
  'La Chine classique': [{ href: frise('chinois-toutes-epoques', 'CONFUCIUS'), label: 'Les philosophes chinois sur la frise' }, M.axial],
  'La Corée': [{ href: frise('coreens-toutes-epoques', 'WONHYO'), label: 'Les philosophes coréens sur la frise' }],
  'Le Japon': [{ href: frise('japonais-toutes-epoques', 'KÜKAI'), label: 'Les philosophes japonais sur la frise' }, M.tout],
  'L’âge d’or de la pensée islamique': [{ href: frise('monde-islamique-toutes-epoques', 'AL-KINDI'), label: 'Le monde islamique sur la frise' }, M.orIslam],
  'L’islam moderne': [{ href: frise('monde-islamique-toutes-epoques', 'Djemal ad-Din AL-AFGHANI'), label: 'L’islam moderne sur la frise' }],
  'La pensée juive': [{ href: frise('pensee-juive-toutes-epoques', 'Moïse MAÏMONIDE'), label: 'Les philosophes juifs sur la frise' }, M.tout],
  'La Russie': [{ href: frise('pensee-russe-toutes-epoques', 'Piotr TCHAADAÏEV'), label: 'La pensée russe sur la frise' }],
  'L’Afrique': [{ href: frise('afrique-subsaharienne-toutes-epoques', 'Zera YACOB'), label: 'Les philosophes africains sur la frise' }, { href: frise('pensees-du-sud-toutes-epoques'), label: 'Pensées du Sud' }],
  'Les Amériques et les Caraïbes': [{ href: frise('pensees-du-sud-toutes-epoques', 'NEZAHUALCOYOTL'), label: 'Les pensées du Sud sur la frise' }, { href: frise('caraibes-toutes-epoques'), label: 'Penseurs des Caraïbes' }],
};
{
  const inconnus = Object.keys(EXPLORER).filter((n) => !items.some((it) => it.name === n));
  if (inconnus.length) throw new Error(`histoire-des-philosophes : liens Explorer pour des cartouches inconnus ${inconnus}`);
}
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>Histoire des philosophes, de Thalès à nos jours | LaPhilo.fr</title>
  <meta name="description" content="De Thalès à Judith Butler, de Confucius à Fanon : l'histoire des philosophes de sept grandes traditions, racontée époque par époque." />
  <SeoHead
    title="Histoire des philosophes, de Thalès à nos jours | LaPhilo.fr"
    description="De Thalès à Judith Butler, de Confucius à Fanon : l'histoire des philosophes de sept grandes traditions, racontée époque par époque."
    path="/histoire-des-philosophes/"
    ariane={[['L’histoire des philosophes', '/histoire-des-philosophes/']]}
  />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css?v=20261007" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">L’histoire des philosophes</h1>
  <p class="site-subtitle">De l’Antiquité à nos jours, sur tous les continents</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page def-page">
  <div class="intro-text-col" set:html={introHtml} />

  <div class="drawer-intro-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">✦</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <nav class="def-sommaire def-sommaire--toujours" aria-label="Les sept traditions">
    {TRADITIONS.map((t) => <a href={`#${t.id}`}>{t.nav}</a>)}
  </nav>
  <p class="def-chapeau">Ouvrez une période ou une tradition pour sa vidéo et ses grandes figures, puis retrouvez-les sur les frises chronologiques.</p>

  {TRADITIONS.map((t, i) => (
    <section class="def-tradition" aria-labelledby={t.id}>
      {i > 0 && (
        <div class="drawer-intro-sep def-sep" aria-hidden="true">
          <span class="drawer-intro-sep-line"></span>
          <span class="drawer-intro-sep-ornament">✦</span>
          <span class="drawer-intro-sep-line"></span>
        </div>
      )}
      <h2 class="def-titre" id={t.id}>{t.titre}</h2>
      <p class="def-chapeau">{t.chapeau}</p>

      {t.groupes.map((g) => (
      <>
      {g.titre && <h3 class="def-sous" set:html={g.titre} />}
      <div class="acc-list">
        {g.cartes.map(carte).map((it) => (
          <div class="acc-item">
            <button class="acc-toggle" aria-expanded="false" type="button">
              <span class="acc-name">{it.name}</span>
              <span class="acc-date" set:html={it.tag} />
              <span class="acc-chevron" aria-hidden="true">▶</span>
            </button>
            <div class="acc-content">
              {it.ytId && (
                <div class="acc-video">
                  <div class="youtube-container" data-id={it.ytId}>
                    <img src={`https://img.youtube.com/vi/${it.ytId}/hqdefault.jpg`} alt={`Vidéo : ${it.name}`} loading="lazy" width="480" height="360" />
                    <button class="play-button" aria-label={`Lancer la vidéo : ${it.name}`}></button>
                  </div>
                </div>
              )}
              <div class="acc-text" set:html={it.text} />
              {EXPLORER[it.name] && (
                <div class="def-explorer">
                  <span class="def-explorer-lbl">Explorer sur LaPhilo.fr</span>
                  {EXPLORER[it.name].map((l, j) => (
                    <a class={j === 0 ? 'def-explorer-main' : undefined} href={l.href}
                       target={l.monde ? '_blank' : undefined} rel={l.monde ? 'noopener' : undefined}>
                      {j === 0 ? `${l.label} →` : l.label}{l.monde && ' ↗'}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
      </>
      ))}
    </section>
  ))}

  <div class="drawer-intro-sep def-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">✦</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <!-- La Frise et le Tableau des penseurs (composant réutilisable), juste avant « Continuer le voyage » -->
  <CartoucheMonde vue="penseurs" />

  <Voyage href="/frises/" />
</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/home-portraits.js" defer></script>
<script src="/js/accordion.js" defer></script>

</body>
</html>
