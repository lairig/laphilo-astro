---
import Favicons from '../components/Favicons.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import data from '../data/frises-catalogue.json';

const { intro, groups } = data as {
  intro: string;
  groups: {
    section?: string;
    label: string;
    items: {
      name: string;
      tag: string;
      text: string;
      href?: string;
      links?: { label: string; href: string }[];
    }[];
  }[];
};
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>Toutes les frises chronologiques — La Philo</title>
  <meta name="description" content="Le catalogue complet des frises chronologiques interactives de LaPhilo.fr : philosophes par nationalité et par époque, grands courants de pensée occidentaux et orientaux." />
  <SeoHead
    title="Toutes les frises chronologiques — La Philo"
    description="Le catalogue complet des frises chronologiques interactives de LaPhilo.fr : philosophes par nationalité et par époque, grands courants de pensée occidentaux et orientaux."
    path="/frises/"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css" />
  <style>
    .frises-section-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(1.25rem, 3vw, 1.75rem);
      font-weight: 700;
      letter-spacing: 0.06em;
      text-align: center;
      color: #d4a843;
      margin: 3.2rem 0 1.2rem;
      padding: 0.9rem 1rem;
      border-top: 1px solid rgba(212, 168, 67, 0.5);
      border-bottom: 1px solid rgba(212, 168, 67, 0.5);
      background: linear-gradient(90deg, transparent, rgba(180, 130, 20, 0.16), transparent);
      text-shadow: 0 0 18px rgba(212, 168, 67, 0.25);
    }
    .drawer-intro-sep + .frises-section-title { margin-top: 0.4rem; }
  </style>
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Toutes les Frises</h1>
  <p class="site-subtitle">Philosophes et courants de pensée, frise par frise</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page">
  <div class="intro-text-col" set:html={intro} />

  <div class="drawer-intro-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">✦</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  {groups.map((group, gi) => (
    <>
      {group.section && <h2 class="frises-section-title">{group.section}</h2>}
      {gi > 0 && (
        <div class="definition-section-sep" aria-hidden="true">
          <span class="drawer-intro-sep-line"></span>
          <span class="drawer-intro-sep-ornament">{group.label}</span>
          <span class="drawer-intro-sep-line"></span>
        </div>
      )}
      {gi === 0 && !group.section && (
        <h3 style="font-family:'Cinzel',serif;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin:0 0 .8rem;opacity:.8;">✦ {group.label}</h3>
      )}
      <div class="acc-list">
        {group.items.map((it) => (
          <div class="acc-item">
            <button class="acc-toggle" aria-expanded="false" type="button">
              <span class="acc-name" set:html={it.name} />
              <span class="acc-date">{it.tag}</span>
              <span class="acc-chevron" aria-hidden="true">▶</span>
            </button>
            <div class="acc-content">
              <div class="acc-text">
                {it.text}
                <br />
                <div style="display:flex;gap:.6rem;margin-top:.6rem;flex-wrap:wrap;">
                  {it.links
                    ? it.links.map((link) => (
                        <a href={link.href} class="parch-link" set:html={`${link.label} →`} />
                      ))
                    : <a href={it.href} class="parch-link">Accéder à la frise →</a>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </>
  ))}
</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/accordion.js" defer></script>

</body>
</html>
