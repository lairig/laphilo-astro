---
import { getCollection } from 'astro:content';
import SlideCard from '../../components/SlideCard.astro';
import FicheNav from '../../components/FicheNav.astro';
import FicheHeader from '../../components/FicheHeader.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import SeoHead from '../../components/SeoHead.astro';

export async function getStaticPaths() {
  const philosophes = await getCollection('philosophes');
  const courants = await getCollection('courants');
  const courantIdByName = new Map(courants.map((c) => [c.data.name, c.id]));

  const bySource = new Map<string, typeof philosophes>();
  for (const entry of philosophes) {
    const key = entry.data.frise_source;
    if (!bySource.has(key)) bySource.set(key, []);
    bySource.get(key)!.push(entry);
  }
  for (const items of bySource.values()) {
    items.sort((a, b) => a.data.year - b.data.year);
  }

  return philosophes.map((entry) => {
    const siblings = bySource.get(entry.data.frise_source)!;
    const index = siblings.findIndex((e) => e.id === entry.id);
    const courantLinks = (entry.data.courants || [])
      .map((name) => {
        const id = courantIdByName.get(name);
        return id ? { href: `/courants/${id}/`, label: name } : null;
      })
      .filter((x): x is { href: string; label: string } => x !== null);
    return {
      params: { id: entry.id },
      props: {
        entry,
        prev: index > 0 ? siblings[index - 1] : undefined,
        next: index < siblings.length - 1 ? siblings[index + 1] : undefined,
        position: index + 1,
        total: siblings.length,
        courantLinks,
      },
    };
  });
}

const { entry, prev, next, position, total, courantLinks } = Astro.props;
const p = entry.data;

const title = `${p.name} — La Philo`;
const description = p.description || p.display_date;
const path = `/philosophes/${entry.id}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'La Philo', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: p.frise_label, item: new URL(`/philosophes/frise/${p.frise_source}/`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: p.name, item: new URL(path, Astro.site).toString() },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: p.name,
    description,
    url: new URL(path, Astro.site).toString(),
    ...(p.nationalite ? { nationality: p.nationalite } : {}),
    ...(p.thumbnail ? { image: new URL(p.thumbnail, Astro.site).toString() } : {}),
    knowsAbout: p.courants,
  },
];
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead title={title} description={description} path={path} jsonLd={jsonLd} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/styles-f.css" />
</head>
<body>

<FicheHeader title={p.name} listHref={`/philosophes/frise/${p.frise_source}/`} />

<div class="frise-body">
  <FicheNav
    basePath="/philosophes"
    prev={prev ? { id: prev.id, name: prev.data.name, display_date: prev.data.display_date } : undefined}
    next={next ? { id: next.id, name: next.data.name, display_date: next.data.display_date } : undefined}
    current={position}
    total={total}
    listHref={`/philosophes/frise/${p.frise_source}/`}
    listLabel={p.frise_label}
  />
  <div class="slide-area">
    <div class="slides-container">
      <SlideCard
        name={p.name}
        displayDate={p.display_date}
        text={p.text}
        ytId={p.yt_id}
        mediaCredit={p.media_credit}
        thumbnail={p.thumbnail}
        imageMedia={p.image_media}
      >
        <CrossLinks label="Courants de pensée" items={courantLinks} threshold={6} />
      </SlideCard>
    </div>
  </div>
</div>

</body>
</html>
