---
import { getCollection } from 'astro:content';
import SlideCard from '../../components/SlideCard.astro';
import FicheNav from '../../components/FicheNav.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import { markerColor, eraLabel } from '../../lib/era';

export async function getStaticPaths() {
  const courants = await getCollection('courants');
  const philosophes = await getCollection('philosophes');

  const philosophesByCourant = new Map<string, { id: string; name: string; year: number }[]>();
  for (const p of philosophes) {
    for (const cname of p.data.courants || []) {
      if (!philosophesByCourant.has(cname)) philosophesByCourant.set(cname, []);
      philosophesByCourant.get(cname)!.push({ id: p.id, name: p.data.name, year: p.data.year });
    }
  }
  for (const list of philosophesByCourant.values()) {
    list.sort((a, b) => a.year - b.year);
  }

  const bySource = new Map<string, typeof courants>();
  for (const entry of courants) {
    const key = entry.data.frise_source;
    if (!bySource.has(key)) bySource.set(key, []);
    bySource.get(key)!.push(entry);
  }
  for (const items of bySource.values()) {
    items.sort((a, b) => a.data.year - b.data.year);
  }

  return courants.map((entry) => {
    const siblings = bySource.get(entry.data.frise_source)!;
    const index = siblings.findIndex((e) => e.id === entry.id);
    const philosopheLinks = (philosophesByCourant.get(entry.data.name) || []).map((p) => ({
      href: `/philosophes/${p.id}/`,
      label: p.name,
    }));
    return {
      params: { id: entry.id },
      props: {
        entry,
        indexInFrise: index,
        prev: index > 0 ? siblings[index - 1] : undefined,
        next: index < siblings.length - 1 ? siblings[index + 1] : undefined,
        position: index + 1,
        total: siblings.length,
        philosopheLinks,
      },
    };
  });
}

const { entry, indexInFrise, prev, next, position, total, philosopheLinks } = Astro.props;
const c = entry.data;

const eraBadge = { color: markerColor(indexInFrise), label: eraLabel(c.year) };
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{c.name} — La Philo</title>
  <meta name="description" content={c.description || c.display_date} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/styles-f.css" />
</head>
<body>

<header class="frise-header">
  <h1>{c.name}</h1>
  <div class="header-rule"></div>
</header>

<div class="frise-body">
  <FicheNav
    basePath="/courants"
    prev={prev ? { id: prev.id, name: prev.data.name, display_date: prev.data.display_date } : undefined}
    next={next ? { id: next.id, name: next.data.name, display_date: next.data.display_date } : undefined}
    current={position}
    total={total}
    listHref={`/courants/frise/${c.frise_source}/`}
    listLabel={c.frise_label}
  />
  <div class="slide-area">
    <div class="slides-container">
      <SlideCard
        name={c.name}
        displayDate={c.display_date}
        text={c.text}
        ytId={c.yt_id}
        mediaCredit={c.media_credit}
        imageMedia={c.image_media}
        eraBadge={eraBadge}
      >
        <CrossLinks label="Principaux représentants" items={philosopheLinks} threshold={6} />
      </SlideCard>
    </div>
  </div>
</div>

</body>
</html>
