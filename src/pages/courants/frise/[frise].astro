---
import Favicons from '../../../components/Favicons.astro';
import { getCollection } from 'astro:content';
import { courantFriseConfig } from '../../../data/frise-engine-config';

export async function getStaticPaths() {
  const courants = await getCollection('courants');
  const bySource = new Map<string, { label: string; count: number }>();
  for (const entry of courants) {
    const key = entry.data.frise_source;
    if (!bySource.has(key)) bySource.set(key, { label: entry.data.frise_label, count: 0 });
    bySource.get(key)!.count++;
  }
  return Array.from(bySource.entries()).map(([frise, { label, count }]) => ({
    params: { frise },
    props: { label, count },
  }));
}

const { frise } = Astro.params;
const { label, count } = Astro.props;
const cfg = courantFriseConfig[frise as string] ?? { defaultIndex: 0, scale_factor: 9, mode: 'courant' };
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <title>{label} — La Philo</title>
  <meta name="description" content={`${label} : ${count} fiches sur une frise chronologique interactive.`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,500;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles-f.css" />
</head>
<body>

<div id="loader">
  <div class="loader-ornament">{label.toUpperCase()}</div>
  <div class="loader-bar"><div class="loader-bar-fill" id="loaderFill"></div></div>
  <div class="loader-msg" id="loaderMsg">Chargement…</div>
</div>

<header class="frise-header">
  <div class="frise-header-actions">
    <a href="/" class="fha-btn fha-home" aria-label="Accueil">⌂ <span>Accueil</span></a>
    <div class="fha-right">
      <button id="frise-mini-list-btn" class="fha-btn" type="button" aria-label="Liste">&#9776; <span>Liste</span></button>
      <a href="/recherche/" class="fha-btn" aria-label="Recherche">&#128269; <span>Recherche</span></a>
    </div>
  </div>
  <h1>{label}</h1>
  <p>{count} fiches sur une frise chronologique interactive.</p>
  <div class="header-rule"></div>
</header>

<div class="frise-body" id="friseBody" style="visibility:hidden">
  <div class="frise-cols">
    <div class="timeline-nav-wrap" id="navWrap">
      <div class="timeline-axis"></div>
      <div class="nav-cursor"></div>
      <div class="nav-counter" id="navCounter"></div>
      <div class="timeline-nav-track" id="navTrack"></div>
      <div class="time-rule-track" id="timeRuleTrack"></div>
    </div>

    <div id="mobileHeader" class="mobile-header" aria-live="polite"></div>

    <div class="slide-area" id="slideArea">
      <div class="slides-container" id="slidesContainer"></div>
    </div>
  </div>
</div>

<footer class="frise-footer">
  <p class="ff-tagline footer-tagline">Sans la musique, la vie serait une erreur ♪</p>
  <p class="ff-copy">© 2026 – laphilo.fr – Refonte en cours</p>
</footer>

<script define:vars={{ frise, cfg }}>
  window.FRISE_CONFIG = {
    jsonUrl: `/courants/frise/${frise}.json`,
    ...cfg,
  };
</script>

<script src="/js/frise-engine.js" defer></script>

</body>
</html>
