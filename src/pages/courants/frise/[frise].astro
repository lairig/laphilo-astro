---
import Favicons from '../../../components/Favicons.astro';
import Fonts from '../../../components/Fonts.astro';
import GoatCounter from '../../../components/GoatCounter.astro';
import SeoHead from '../../../components/SeoHead.astro';
import BackButton from '../../../components/BackButton.astro';
import FriseFooter from '../../../components/FriseFooter.astro';
import { plainText, titreSeo, descriptionSeo } from '../../../lib/seo';
import { getCollection } from 'astro:content';
import { courantFriseConfig, courantFriseDefaut, courantFriseSlugs, courantsDeLaFrise, libelleFriseCourant } from '../../../data/frise-engine-config';
import friseDescriptions from '../../../data/frise-descriptions.json';

export async function getStaticPaths() {
  const courants = await getCollection('courants');
  /* Frises complètes, sous-frises thématiques, frises par tradition et frises
     « monde » par thème : voir courantsDeLaFrise (frise-engine-config.ts) */
  return courantFriseSlugs().map((frise) => {
    const sorted = courantsDeLaFrise(frise, courants)!.slice().sort((a, b) => a.data.year - b.data.year);
    const indexItems = sorted.map((entry) => ({
      id: entry.id,
      name: entry.data.name,
      displayDate: entry.data.display_date,
      branches: entry.data.branches,
      description: entry.data.description ? plainText(entry.data.description) : entry.data.description,
    }));
    return {
      params: { frise },
      props: { label: libelleFriseCourant(frise), count: sorted.length, indexItems },
    };
  });
}

const { frise } = Astro.params;
const { label, count, indexItems } = Astro.props;
const cfg = courantFriseConfig[frise as string] ?? courantFriseDefaut;
const description = (friseDescriptions as Record<string, string>)[frise as string] ?? `${count} fiches sur une frise chronologique interactive.`;
const descriptionText = description.replace(/<[^>]+>/g, '');
/* Pas de « Philosophes médiévaux — Philosophes médiévaux (…) » : le libellé
   n'est ajouté que si le texte ne commence pas déjà par lui. */
const metaDescription = descriptionSeo(label, descriptionText);
const title = titreSeo(label);
const path = `/courants/frise/${frise}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'LaPhilo.fr', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Toutes les frises', item: new URL('/frises/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: label, item: new URL(path, Astro.site).toString() },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: label,
    description: descriptionText,
    url: new URL(path, Astro.site).toString(),
  },
];
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <SeoHead title={title} description={metaDescription} path={path} jsonLd={jsonLd} />

  <Fonts faces={['Cinzel Decorative 700', 'Cinzel 400', 'Cinzel 600', 'Cinzel 700', 'EB Garamond 500', 'EB Garamond 400 italic']} />
  <!-- Données de la frise demandées dès le début, en parallèle du script. -->
  <link rel="preload" href={`/courants/frise/${frise}.json`} as="fetch" crossorigin="anonymous" />
  <link rel="stylesheet" href="/css/styles-f.css?v=20261006" />
</head>
<body>

<div id="loader">
  <div class="loader-ornament">{label.toUpperCase()}</div>
  <div class="loader-bar"><div class="loader-bar-fill" id="loaderFill"></div></div>
  <div class="loader-msg" id="loaderMsg">Chargement…</div>
</div>

<header class="frise-header">
  <div class="frise-header-actions">
    <div class="fha-left">
      <BackButton variant="fha" />
      <a href="/" class="fha-btn fha-home" aria-label="Accueil"><span class="fha-ico" aria-hidden="true">⌂</span> <span class="fha-lbl">Accueil</span></a>
    </div>
    <div class="fha-right">
      <button id="frise-mini-list-btn" class="fha-btn" type="button" aria-label="Liste"><span class="fha-ico" aria-hidden="true">&#9776;</span> <span class="fha-lbl">Liste</span></button>
      <a href="/recherche/" class="fha-btn" aria-label="Recherche"><span class="fha-ico" aria-hidden="true">&#128269;</span> <span class="fha-lbl">Recherche</span></a>
    </div>
  </div>
  <h1>{label}</h1>
  <p set:html={description} />
  <div class="header-rule"></div>
</header>

<section class="ff-index" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">
  <h2>{label} ({count})</h2>
  <ul>
    {indexItems.map((it) => (
      <li>
        <strong><a href={`/courants/${it.id}/`}>{it.name}</a></strong>
        {' '}({it.displayDate}{it.branches && it.branches.length ? ` · ${it.branches.join(', ')}` : ''})
        {' — '}{it.description}
      </li>
    ))}
  </ul>
</section>

<div class="frise-body" id="friseBody" style="visibility:hidden">
  <div class="frise-cols">
    <div class="timeline-nav-wrap" id="navWrap">
      <div class="timeline-axis"></div>
      <div class="nav-cursor"></div>
      <div class="nav-counter" id="navCounter"></div>
      <div class="timeline-nav-track" id="navTrack"></div>
      <div class="time-rule-track" id="timeRuleTrack"></div>
    </div>

    <div id="mobileHeader" class="mobile-header" aria-live="polite"></div>

    <div class="slide-area" id="slideArea">
      <div class="slides-container" id="slidesContainer"></div>
    </div>
  </div>
</div>

<FriseFooter />

<script define:vars={{ frise, cfg }}>
  window.FRISE_CONFIG = {
    jsonUrl: `/courants/frise/${frise}.json`,
    ...cfg,
  };
</script>

<script src="/js/slide-media.js" defer></script>
<script src="/js/frise-engine.js?v=20260930" defer></script>

</body>
</html>
