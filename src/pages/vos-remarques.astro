---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';

/* Clé publique de la vérification anti-robot Cloudflare Turnstile (tableau de bord
   Cloudflare > Turnstile). Vide : pas de vérification, le Worker se contente du champ
   piège et de la limite de messages par heure. */
const TURNSTILE_SITEKEY = '0x4AAAAAAFTRHfZ70DJRAIIN';

const title = 'Vos remarques sur les philosophes | LaPhilo.fr';
const description = 'Une erreur dans une fiche, un philosophe oublié, une question ? Laissez votre remarque : chaque message est lu avant d’être publié.';
/* Types de message : code, titre, sous-titre, signe dans la pastille dorée */
const TYPES = [
  ['erreur', 'Une erreur', 'Une date, un nom, un lien', '!'],
  ['suggestion', 'Une suggestion', 'Un penseur oublié, une idée', '✦'],
  ['question', 'Une question', 'Sur un philosophe, un courant', '?'],
  ['autre', 'Un mot', 'Une remarque, un encouragement', '✎'],
];
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead
    title={title}
    description={description}
    path="/vos-remarques/"
    ariane={[['Vos remarques', '/vos-remarques/']]}
  />

  <Fonts faces={['Cinzel Decorative 700', 'Cinzel 400', 'Cinzel 600', 'Cinzel 700', 'EB Garamond 400', 'EB Garamond 500', 'EB Garamond 400 italic']} />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/remarques.css?v=20261011" />
  {TURNSTILE_SITEKEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Vos remarques</h1>
  <p class="site-subtitle">Le site s’écrit aussi avec ses lecteurs</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="rq">

  <p class="rq-accroche">
    Une date erronée, un penseur oublié, une question qui vous travaille ? <br />
    Écrivez-nous : <em>chaque message est lu avant d’être publié.</em>
  </p>

  <form id="rq-form" class="rq-form" novalidate>
    <fieldset class="rq-types">
      <legend class="rq-titre">Vous souhaitez partager…</legend>
      <div class="rq-types-grille">
        {TYPES.map(([v, t, s, ic]) => (
          <label class="rq-type">
            <input type="radio" name="categorie" value={v} checked={v === 'autre'} />
            <span class="rq-pastille" aria-hidden="true">{ic}</span>
            <span class="rq-type-txt"><strong>{t}</strong><span>{s}</span></span>
          </label>
        ))}
      </div>
    </fieldset>

    <section class="rq-parch" id="laisser" aria-label="Votre message">
      <div class="rq-champs">
        <label class="rq-champ">
          <span class="rq-etiq">Votre nom ou pseudo</span>
          <input type="text" id="rq-nom" name="nom" required maxlength="60" autocomplete="nickname" />
        </label>
        <label class="rq-champ">
          <span class="rq-etiq" id="rq-email-label">E-mail <small>facultatif, jamais affiché</small></span>
          <input type="email" id="rq-email" name="email" maxlength="120" autocomplete="email" />
        </label>
        <label class="rq-champ rq-champ--large">
          <span class="rq-etiq">À propos de <small>facultatif</small></span>
          <input type="text" id="rq-fiche" list="rq-fiches" maxlength="120" placeholder="Nom d’un philosophe ou d’un courant…" autocomplete="off" />
          <datalist id="rq-fiches"></datalist>
        </label>
        <label class="rq-champ rq-champ--large">
          <span class="rq-etiq">Votre message</span>
          <textarea id="rq-message" name="message" required rows="6" maxlength="4000"></textarea>
        </label>
      </div>

      <label class="rq-interrupteur">
        <input type="checkbox" id="rq-prive" name="prive" />
        <span class="rq-curseur" aria-hidden="true"></span>
        <span><strong>Message privé</strong> : ne pas publier, pour l’auteur du site uniquement
          <small>(indiquez alors votre e-mail pour recevoir la réponse)</small></span>
      </label>

      <input type="text" name="site" class="rq-piege" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="rq-pied-form">
        {TURNSTILE_SITEKEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-language="fr" data-theme="light"></div>}
        <button type="submit" class="rq-envoyer" id="rq-envoyer">Envoyer le message</button>
      </div>
      <p id="rq-retour" class="rq-retour" role="status" aria-live="polite"></p>
    </section>
  </form>

  <section class="rq-liste" aria-labelledby="rq-titre-liste">
    <h2 id="rq-titre-liste" class="rq-titre">Ce que vous nous avez écrit <span id="rq-total"></span></h2>
    <div class="rq-filtres" role="group" aria-label="Filtrer par type">
      <button type="button" class="rq-filtre actif" data-cat="">Tous</button>
      <button type="button" class="rq-filtre" data-cat="erreur">Erreurs</button>
      <button type="button" class="rq-filtre" data-cat="suggestion">Suggestions</button>
      <button type="button" class="rq-filtre" data-cat="question">Questions</button>
      <button type="button" class="rq-filtre" data-cat="autre">Remarques</button>
    </div>
    <div id="rq-messages"><p class="rq-vide">Chargement des messages…</p></div>
    <p class="rq-plus-ligne"><button type="button" id="rq-plus" class="rq-plus" hidden>Messages plus anciens</button></p>
  </section>

</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script is:inline src="/js/home-main.js" defer></script>
<script is:inline src="/js/remarques.js?v=20261011" defer></script>

</body>
</html>
