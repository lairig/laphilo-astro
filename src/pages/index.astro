---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import { getCollection } from 'astro:content';
import { getAlaunePools, alauneHtml, dayOfYear } from '../lib/alaune';

const philosophes = await getCollection('philosophes');
const courants = await getCollection('courants');
const buildDay = dayOfYear(new Date());
const alaune = alauneHtml(await getAlaunePools(), buildDay);

const title = `${philosophes.length} philosophes, ${courants.length} courants de pensée : LaPhilo.fr`;
const description = `${philosophes.length} philosophes et ${courants.length} courants de pensée sur des frises chronologiques interactives, de l'Antiquité à aujourd'hui, occidentale comme orientale.`;
const path = '/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LaPhilo.fr',
    url: new URL('/', Astro.site).toString(),
    description,
    inLanguage: 'fr-FR',
    publisher: {
      '@type': 'Organization',
      name: 'LaPhilo.fr',
      url: new URL('/', Astro.site).toString(),
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
    },
  },
];
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>{title}</title>
  <meta name="description" content={description} />
  <SeoHead title={title} description={description} path={path} jsonLd={jsonLd} />

  <Fonts />
  <link rel="preconnect" href="https://www.youtube-nocookie.com" />
  <link rel="preconnect" href="https://i.ytimg.com" />

  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/home-extra.css?v=20261002b" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
  </div>
  <h1 class="site-title">l'Homme &amp; la Philosophie</h1>
  <p class="site-subtitle">LaPhilo.fr — Ressource mise à jour 2026</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main>

<div class="timeline-section timeline-section--top">
  <p class="timeline-section-subtitle" id="js-stats-fr"><span class="stats-group">✦ <span class="stats-num">{courants.length}</span> courants de pensée</span> <span class="stats-group">✦ <span class="stats-num">{philosophes.length}</span> philosophes</span></p>

  <nav class="entry-guide" aria-label="Par où commencer ?">
    <div class="entry-guide-items">
      <a class="entry-guide-btn" href="/bienvenue/">
        <span class="entry-guide-icon">☿</span>
        <span class="entry-guide-text">
          <strong>Nouveau ici</strong>
          <span>Présentation du site</span>
        </span>
      </a>
      <a class="entry-guide-btn" href="/recherche/">
        <span class="entry-guide-icon">⌕</span>
        <span class="entry-guide-text">
          <strong>Recherche</strong>
          <span>Philosophes et courants</span>
        </span>
      </a>
      <a class="entry-guide-btn" href="/histoire-des-philosophes/">
        <span class="entry-guide-icon">◈</span>
        <span class="entry-guide-text">
          <strong>Explorer les penseurs</strong>
          <span>Frise et tableau des penseurs</span>
        </span>
      </a>
      <a class="entry-guide-btn" href="/histoire-des-courants/">
        <span class="entry-guide-icon">✧</span>
        <span class="entry-guide-text">
          <strong>Explorer les courants</strong>
          <span>Frise et tableau des courants</span>
        </span>
      </a>
    </div>
  </nav>
</div>

<div class="intro-cartouche">
  <div class="intro-cartouche-inner">
    <div class="intro-video-col">
      <div class="youtube-container" data-id="8R_91lwL62A">
        <img src="https://img.youtube.com/vi/8R_91lwL62A/hqdefault.jpg"
             alt="Vidéo : Introduction à la philosophie"
             fetchpriority="high" width="480" height="360" />
        <button class="play-button" aria-label="Lancer la vidéo : Introduction à la philosophie"></button>
      </div>
      <p class="intro-video-caption">Philosopher, c'est s'étonner</p>
    </div>
    <div class="intro-text-col">
      <p class="intro-drop-cap">Née de la Grèce antique, la philosophie est l'art de questionner nos évidences, l'existence, la liberté, la justice. Éveiller, transformer le doute en curiosité.</p>
      <p class="intro-body">Sur 25 siècles de traditions occidentale, arabe, indienne, chinoise, africaine, chacune a apporté sa lumière sur des énigmes fondamentales : Qui suis-je ? Qu'est-ce que la vérité ?</p>
      <p class="intro-body">LaPhilo.fr vous propose un voyage à travers le temps et les cultures, frises interactives, textes, vidéos et podcasts pour comprendre comment la pensée humaine s'est construite.</p>
    </div>
  </div>
</div>

<div class="alaune-sep" aria-hidden="true"><span class="alaune-sep-mark">✦</span></div>

<div class="alaune-wrap" id="alaune-wrap" data-day={buildDay} set:html={alaune}></div>

<div class="timeline-section">
  <div class="timeline-spine" role="list" aria-label="Accès aux grandes sections philosophiques">

    <!-- Côtés : tl-node--left = carte à droite de l'axe (flèche à gauche), tl-node--right = carte à gauche. -->
    <!-- Ordre du parcours « Continuer le voyage » : bienvenue → définition → courants → philosophes → frises -->
    <div class="tl-node tl-node--featured tl-node--right" role="listitem">
      <div class="tl-jewel tl-jewel--featured" aria-hidden="true"></div>
      <div class="tl-card tl-card--featured">
        <div class="tl-era">✦ Nouveau ici · Mode d'emploi</div>
        <h2 class="tl-title">Bienvenue</h2>
        <p class="tl-desc">Ce que le site vous offre, par où commencer, comment lire une frise : le voyage commence ici. Quelques minutes suffisent pour trouver ses repères et choisir son chemin.</p>
        <a class="tl-cta-alt tl-cta-alt--sec" href="/bienvenue/">Étape 1 <span class="tl-arrow">→</span></a>
      </div>
    </div>

    <div class="tl-node tl-node--left" role="listitem">
      <div class="tl-jewel" aria-hidden="true"></div>
      <div class="tl-card">
        <div class="tl-era">☿ Définition · Branches</div>
        <h2 class="tl-title">C'est quoi la philosophie ?</h2>
        <p class="tl-desc">Poser les bases du voyage : sept grandes branches et neuf « philosophies de… », expliquées en vidéos et en podcasts. De quoi savoir ce que cherchent les philosophes avant de les rencontrer.</p>
        <a class="tl-cta-alt tl-cta-alt--sec" href="/definition/">Étape 2 <span class="tl-arrow">→</span></a>
      </div>
    </div>

    <div class="tl-node tl-node--right" role="listitem">
      <div class="tl-jewel" aria-hidden="true"></div>
      <div class="tl-card">
        <div class="tl-era">🌍 Occident · Orient · Afrique · Amériques</div>
        <h2 class="tl-title">Les Courants de pensée</h2>
        <p class="tl-desc">Le voyage continue d'une famille d'idées à l'autre : du stoïcisme au Tao, de la falsafa à l'Ubuntu. Chaque courant raconte une manière de voir le monde, ses origines et ses héritiers.</p>
        <a class="tl-cta-alt tl-cta-alt--sec" href="/histoire-des-courants/">Étape 3 <span class="tl-arrow">→</span></a>
      </div>
    </div>

    <div class="tl-node tl-node--left" role="listitem">
      <div class="tl-jewel" aria-hidden="true"></div>
      <div class="tl-card">
        <div class="tl-era">🏛 VIᵉ av. J.-C. → aujourd'hui</div>
        <h2 class="tl-title">Les Philosophes</h2>
        <p class="tl-desc">Un voyage dans le temps : des présocratiques aux penseurs d'aujourd'hui, d'Occident et d'ailleurs. Leur vie, leurs grandes idées et ce qu'ils nous apprennent encore.</p>
        <a class="tl-cta-alt tl-cta-alt--sec" href="/histoire-des-philosophes/">Étape 4 <span class="tl-arrow">→</span></a>
      </div>
    </div>

    <div class="tl-node tl-node--right" role="listitem">
      <div class="tl-jewel" aria-hidden="true"></div>
      <div class="tl-card">
        <div class="tl-era">📜 Égypte ancienne → XXIᵉ siècle</div>
        <h2 class="tl-title">Les Frises Temporelles</h2>
        <p class="tl-desc">Le voyage devient exploration libre : des dizaines de frises interactives, jusqu'à la frise des penseurs du monde. On y voit d'un coup d'œil qui pensait quoi, à la même époque, d'un bout à l'autre du monde.</p>
        <a class="tl-cta-alt tl-cta-alt--sec" href="/frises/">Découverte <span class="tl-arrow">→</span></a>
      </div>
    </div>

  </div>
</div>

<div class="intro-cartouche">
  <div class="intro-cartouche-inner">
    <div class="intro-video-col">
      <div class="youtube-container" data-id="-VdXi2LMPyE">
        <img src="https://img.youtube.com/vi/-VdXi2LMPyE/hqdefault.jpg"
             alt="Vidéo : 2500 ans de philosophie"
             loading="lazy" width="480" height="360" />
        <button class="play-button" aria-label="Lancer la vidéo : 2500 ans de philosophie"></button>
      </div>
      <p class="intro-video-caption">2500 ans de philosophie</p>
    </div>
    <div class="intro-text-col">
      <p class="intro-drop-cap">L'histoire de la philosophie est une conversation vivante où les idées ont évolué, se sont heurtées et nourries les unes les autres, c'est comprendre pourquoi nous pensons comme nous pensons aujourd'hui.</p>
      <p class="intro-body">Des présocratiques et le cosmos, aux contemporains et l'A.I, le transhumanisme ou autres formes de pouvoir numérique — chaque génération a repris le flambeau du questionnement. Ces questions habitent chacun d'entre nous, prenons le temps de nous demander pourquoi nous croyons ce que nous croyons, ou ce qui justifie vraiment nos choix moraux et politiques.</p>
    </div>
  </div>
</div>

</main>

<section class="faq-section" aria-label="Questions fréquentes sur la philosophie">
  <div class="faq-inner">
    <h2 class="faq-title">✦ Questions fréquentes</h2>
    <p class="faq-subtitle">Des réponses accessibles aux questions essentielles sur la philosophie</p>

    <div class="faq-grid">
      <details class="faq-item">
        <summary class="faq-question">C'est quoi la philosophie, exactement&nbsp;?</summary>
        <div class="faq-answer">
          <p>La philosophie est la discipline qui interroge les fondements de notre existence, de notre connaissance et de nos valeurs. Elle ne produit pas de résultats mesurables comme la science, ni de dogmes comme la religion — elle avance par questions, arguments et dialogues. Philosopher, c'est refuser les réponses toutes faites et penser par soi-même, avec rigueur et honnêteté intellectuelle.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-question">Quelle est la différence entre la philosophie et la religion&nbsp;?</summary>
        <div class="faq-answer">
          <p>La religion s'appuie sur la foi, la révélation et des textes sacrés pour répondre aux grandes questions. La philosophie, elle, n'accepte que les arguments rationnels — elle remet tout en question, y compris Dieu, l'âme ou l'au-delà, sans s'appuyer sur une autorité extérieure. Cela ne signifie pas qu'elles s'opposent : beaucoup de grands philosophes étaient croyants, et certaines traditions religieuses ont développé une philosophie très rigoureuse.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-question">Quels sont les 3 philosophes les plus importants de l'histoire&nbsp;?</summary>
        <div class="faq-answer">
          <p>Il est impossible de hiérarchiser objectivement, mais trois noms reviennent invariablement : <a href="/philosophes/socrate/" class="faq-name-link">Socrate</a> (fondateur de la méthode dialectique), <a href="/philosophes/platon/" class="faq-name-link">Platon</a> (fondateur de la métaphysique idéaliste) et <a href="/philosophes/aristote/" class="faq-name-link">Aristote</a> (bases de la logique, de l'éthique et de la politique). Kant est souvent considéré comme l'autre pivot incontournable de la philosophie moderne.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-question">À quoi sert la philosophie dans la vie concrète&nbsp;?</summary>
        <div class="faq-answer">
          <p>La philosophie affûte la pensée critique : elle apprend à distinguer un argument solide d'un sophisme, à repérer les manipulations rhétoriques, à clarifier ses propres valeurs et à prendre des décisions plus cohérentes. Elle ne change pas le monde directement, mais elle transforme la façon dont on le perçoit et dont on y agit.</p>
          <p class="faq-link-row"><a href="/definition/" class="faq-link">Définition de la philosophie et ses grandes branches</a></p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-question">Quelle est la différence entre la philosophie orientale et occidentale&nbsp;?</summary>
        <div class="faq-answer">
          <p>La philosophie occidentale, née en Grèce, tend à distinguer le sujet pensant et le monde extérieur, à valoriser l'argumentation logique formelle et à chercher des vérités universelles. La philosophie orientale insiste davantage sur l'harmonie avec la nature, la dissolution de l'ego, la pratique spirituelle et la sagesse vécue. Ces grandes tendances ne sont pas des règles absolues : les deux traditions se sont influencées de plus en plus depuis le XIXᵉ siècle.</p>
          <p class="faq-link-row"><a href="/courants/frise/occidental/" class="faq-link">La pensée occidentale</a> · <a href="/courants/frise/oriental/" class="faq-link">Les autres traditions du monde</a></p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-question">Comment commencer à étudier la philosophie&nbsp;?</summary>
        <div class="faq-answer">
          <p>La meilleure entrée est de lire directement les textes fondateurs : les dialogues de Platon (commencez par l'<em>Apologie de Socrate</em>), les <em>Méditations métaphysiques</em> de Descartes ou les <em>Lettres à Lucilius</em> de Sénèque. Les podcasts de France Culture et les frises chronologiques interactives de LaPhilo.fr sont également d'excellents outils pour s'orienter.</p>
          <p class="faq-link-row"><a href="/philosophes/frise/greco-romains/" class="faq-link">Antiquité gréco-romaine</a> · <a href="/philosophes/frise/modernes/" class="faq-link">Philosophes modernes</a> · <a href="/philosophes/frise/contemporains-monde/" class="faq-link">Contemporains</a></p>
        </div>
      </details>
    </div>
  </div>
</section>

