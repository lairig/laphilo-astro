---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import Voyage from '../components/Voyage.astro';
import CartoucheMonde from '../components/CartoucheMonde.astro';
import data from '../data/definition-courants.json';

const { intro, items } = data as {
  intro: string;
  items: {
    section: string;
    name: string;
    tag: string;
    ytId: string | null;
    text: string;
    audio: { title: string; src: string } | null;
  }[];
};

/* Introduction : mêmes styles que /definition/ (lettrine, texte justifié) au lieu des styles en ligne du JSON */
const introHtml = intro
  .replace(/\s*style="[^"]*"/g, '')
  .replace('<p>', '<p class="intro-drop-cap">')
  .replaceAll('<p>', '<p class="intro-body">')
  /* Accès à la page des familles, visible sur tous les écrans (le sommaire n'apparaît que sur téléphone) */
  + '<p class="intro-body">Pour voir comment ces courants s’enchaînent et se répondent d’une tradition à l’autre, découvrez <a href="/familles-de-pensee/">les familles de pensée et les grands débats</a>.</p>';

/* Les cartouches rangés par grande tradition (les mêmes que les frises des courants, /courants/frise/<frise>/),
   l'Occident découpé en quatre époques. Chaque cartouche du JSON doit figurer une fois et une seule (vérifié au build). */
type Tradition = { id: string; titre: string; nav: string; chapeau: string; frise: string; groupes: { titre?: string; cartes: string[] }[] };
const TRADITIONS: Tradition[] = [
  {
    id: 'orient-ancien', titre: 'Le Proche-Orient ancien', nav: 'Orient ancien', frise: 'orient-ancien',
    chapeau: 'Mésopotamie, Égypte et Iran : les premières sagesses écrites, des Instructions de Shuruppak à Zarathoustra.',
    groupes: [{ cartes: ['Proche-Orient ancien & Iran'] }],
  },
  {
    id: 'occident', titre: 'L’Occident', nav: 'Occident', frise: 'occidental',
    chapeau: 'De la Grèce antique à nos jours, une longue conversation où chaque école répond à celle qui l’a précédée.',
    groupes: [
      { titre: 'L’Antiquité', cartes: ['Philosophie présocratique — Cosmogonie', 'Philosophie classique — Sophisme', 'Philosophie hellénistique'] },
      { titre: 'Moyen Âge et Renaissance', cartes: ['Philosophie médiévale', 'Philosophie de la Renaissance', 'Ésotérismes & gnoses'] },
      { titre: 'Les Temps modernes', cartes: ['Philosophie des Lumières', 'Pensées économiques & libertariennes', 'Philosophie du XIXesiècle', 'Pensée chrétienne moderne'] },
      { titre: 'XX<sup>e</sup> – XXI<sup>e</sup> siècle', cartes: ['Philosophie contemporaine', "Psychanalyse & sciences de l'esprit", 'Luttes & éthiques contemporaines', 'Technique, transhumanisme & nouveaux réalismes'] },
    ],
  },
  {
    id: 'inde', titre: 'L’Inde', nav: 'Inde', frise: 'inde',
    chapeau: 'Des Védas à Gandhi et Ambedkar : le Soi, la souffrance et la libération, en débat entre hindous, bouddhistes et jaïns.',
    groupes: [{ cartes: ['Védas & Upanishads', 'Les six écoles hindoues (Darśanas)', 'Hindouismes de dévotion', 'Bouddhisme & Jaïnisme', "L'Inde moderne : de Ram Mohan Roy à Ambedkar"] }],
  },
  {
    id: 'asie-est', titre: 'L’Asie de l’Est', nav: 'Asie de l’Est', frise: 'asie-est',
    chapeau: 'Chine, Corée et Japon : l’harmonie de la société et de la nature, de Confucius et Laozi à l’école de Kyōto.',
    groupes: [{ cartes: ['Confucianisme & Néoconfucianisme', 'Taoïsme', 'Légisme & Mohisme', 'Shintoïsme, Zen & École de Kyōto'] }],
  },
  {
    id: 'islam-juif', titre: 'L’Islam et la pensée juive', nav: 'Islam et judaïsme', frise: 'islam-juif',
    chapeau: 'Deux traditions du Livre, nourries de philosophie grecque : la raison face à la révélation, de Bagdad à Cordoue, du Talmud à Levinas.',
    groupes: [{ cartes: ['La pensée juive', 'La Falsafa — philosophie rationaliste islamique', "Kalâm & soufisme : théologie et mystique de l'islam", "Réveils de l'islam : Nahda & réformisme"] }],
  },
  {
    id: 'russie', titre: 'La Russie', nav: 'Russie', frise: 'russe',
    chapeau: 'Entre l’Europe et l’Asie, une pensée passionnée par la question de son propre destin.',
    groupes: [{ cartes: ['La pensée russe'] }],
  },
  {
    id: 'afrique-ameriques', titre: 'L’Afrique et les Amériques', nav: 'Afrique et Amériques', frise: 'sud',
    chapeau: 'Sagesses africaines et amérindiennes, puis pensées de la libération face à la colonisation.',
    groupes: [{ cartes: ['Maât, Ubuntu & philosophies africaines', 'Pensées mésoaméricaines & autochtones', 'Négritude, anticolonialisme & pensée décoloniale', 'Théologies & philosophies de la libération'] }],
  },
];
{
  const places = TRADITIONS.flatMap((t) => t.groupes.flatMap((g) => g.cartes));
  const noms = items.map((it) => it.name);
  const manquants = noms.filter((n) => !places.includes(n));
  const inconnus = places.filter((n) => !noms.includes(n));
  const doubles = places.filter((n, i) => places.indexOf(n) !== i);
  if (manquants.length || inconnus.length || doubles.length)
    throw new Error(`histoire-des-courants : cartouches non rangés ${manquants}, inconnus ${inconnus}, en double ${doubles}`);
}

/* Un seul accès par cartouche : la frise à fiches de sa tradition (/courants/frise/<slug>/),
   ouverte sur le premier courant de l'époque (?p = nom exact du courant) */
const EPOQUE_CARTE: Record<string, [string, string]> = {
  'Philosophie présocratique — Cosmogonie': ['occidental', 'Présocratique'],
  'Philosophie classique — Sophisme': ['occidental', 'Sophisme'],
  'Philosophie hellénistique': ['occidental', 'Scepticisme'],
  'Philosophie médiévale': ['occidental', 'Patristique'],
  'Philosophie de la Renaissance': ['occidental', 'Humanisme'],
  'Philosophie des Lumières': ['occidental', 'Cartésianisme'],
  'Philosophie du XIXesiècle': ['occidental', 'Romantisme'],
  'Philosophie contemporaine': ['occidental', 'Herméneutique'],
  'Védas & Upanishads': ['inde', 'Védisme'],
  'Les six écoles hindoues (Darśanas)': ['inde', 'Sâmkhya'],
  'Bouddhisme & Jaïnisme': ['inde', 'Jaïnisme'],
  'Confucianisme & Néoconfucianisme': ['asie-est', 'Confucianisme'],
  'Taoïsme': ['asie-est', 'Taoïsme'],
  'Légisme & Mohisme': ['asie-est', 'Moïsme'],
  'La Falsafa — philosophie rationaliste islamique': ['islam-juif', 'Kalâm'],
  'Maât, Ubuntu & philosophies africaines': ['orient-ancien', 'Egypte antique'],
  'Shintoïsme, Zen & École de Kyōto': ['asie-est', 'Shintoïsme'],
  'Pensées mésoaméricaines & autochtones': ['sud', 'Mysticisme mésoaméricain'],
  /* cartouches des familles ajoutés le 2026-10-06 */
  'Ésotérismes & gnoses': ['orient-ancien', 'Hermétisme'],
  "L'Inde moderne : de Ram Mohan Roy à Ambedkar": ['inde', 'Brahmoïsme'],
  'La pensée juive': ['islam-juif', 'Herméneutique juive'],
  "Réveils de l'islam : Nahda & réformisme": ['islam-juif', 'Fondamentalisme'],
  'La pensée russe': ['russe', 'Slavophilisme'],
  'Négritude, anticolonialisme & pensée décoloniale': ['sud', 'Anticolonialisme'],
  'Théologies & philosophies de la libération': ['sud', 'Théologie de la libération'],
  /* cartouches des familles ajoutés le 2026-10-07 */
  'Pensées économiques & libertariennes': ['occidental', 'Mercantilisme'],
  'Pensée chrétienne moderne': ['occidental', 'Jansénisme'],
  "Psychanalyse & sciences de l'esprit": ['occidental', 'Psychanalyse'],
  'Luttes & éthiques contemporaines': ['occidental', 'Féminisme'],
  'Technique, transhumanisme & nouveaux réalismes': ['occidental', 'Transhumanisme'],
  'Proche-Orient ancien & Iran': ['orient-ancien', 'Mésopotamie antique'],
  'Hindouismes de dévotion': ['inde', 'Bhakti'],
  "Kalâm & soufisme : théologie et mystique de l'islam": ['islam-juif', 'Mutazilisme'],
};
const lienEpoque = (nom: string) => {
  const e = EPOQUE_CARTE[nom];
  return e ? `/courants/frise/${e[0]}/?p=${encodeURIComponent(e[1])}` : null;
};

/* Le lien « Voir la frise → » en fin de texte devient le bouton du bloc « Explorer » */
const FRISE_LIEN = /(?:\s*<br\s*\/?>)*\s*<a class="parch-link" href="([^"]+)">Voir la frise →<\/a>\s*$/;
const cartes = items.map((it) => {
  const m = it.text.match(FRISE_LIEN);
  return { ...it, text: m ? it.text.replace(FRISE_LIEN, '') : it.text, frise: m ? m[1] : null };
});
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>Histoire des courants de pensée du monde | LaPhilo.fr</title>
  <meta name="description" content="Des présocratiques au structuralisme, des Upanishads au zen, du kalâm à la négritude : les courants de pensée de sept traditions, période par période." />
  <SeoHead
    title="Histoire des courants de pensée du monde | LaPhilo.fr"
    description="Des présocratiques au structuralisme, des Upanishads au zen, du kalâm à la négritude : les courants de pensée de sept traditions, période par période."
    path="/histoire-des-courants/"
    ariane={[['Les courants de pensée', '/histoire-des-courants/']]}
  />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css?v=20261007" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Les Courants de pensée</h1>
  <p class="site-subtitle">Occident · Orient · Afrique · Amériques</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page def-page">
  <div class="intro-text-col" set:html={introHtml} />

  <div class="drawer-intro-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">✦</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <p class="def-chapeau">Ouvrez une période pour sa présentation, une vidéo, parfois un podcast, puis retrouvez-la sur la frise des courants de sa tradition.</p>

  {TRADITIONS.map((t, i) => (
    <section class="def-tradition" aria-labelledby={t.id}>
      {i > 0 && (
        <div class="drawer-intro-sep def-sep" aria-hidden="true">
          <span class="drawer-intro-sep-line"></span>
          <span class="drawer-intro-sep-ornament">✦</span>
          <span class="drawer-intro-sep-line"></span>
        </div>
      )}
      <h2 class="def-titre" id={t.id}>{t.titre}</h2>
      <p class="def-chapeau">{t.chapeau}</p>
      <p class="def-frise-lien"><a href={`/courants/frise/${t.frise}/`}>La frise des courants : {t.nav} →</a></p>

      {t.groupes.map((g) => (
      <>
      {g.titre && <h3 class="def-sous" set:html={g.titre} />}
      <div class="acc-list">
        {g.cartes.map((nom) => cartes.find((it) => it.name === nom)!).map((it) => (
          <div class="acc-item">
            <button class="acc-toggle" aria-expanded="false" type="button">
              <span class="acc-name">{it.name}</span>
              <span class="acc-date" set:html={it.tag} />
              <span class="acc-chevron" aria-hidden="true">▶</span>
            </button>
            <div class="acc-content">
              {it.ytId && (
                <div class="acc-video">
                  <div class="youtube-container" data-id={it.ytId}>
                    <img src={`https://img.youtube.com/vi/${it.ytId}/hqdefault.jpg`} alt={`Vidéo : ${it.name}`} loading="lazy" width="480" height="360" />
                    <button class="play-button" aria-label={`Lancer la vidéo : ${it.name}`}></button>
                  </div>
                </div>
              )}
              <div class="acc-text" set:html={it.text} />
              {it.audio && (
                <div class="acc-audio">
                  <span class="acc-audio-lbl">France Culture</span>
                  <audio controls preload="none" title={it.audio.title}>
                    <source src={it.audio.src} type="audio/mpeg" />
                  </audio>
                </div>
              )}
              <div class="def-explorer">
                <span class="def-explorer-lbl">Explorer sur LaPhilo.fr</span>
                {(lienEpoque(it.name) ?? it.frise) && <a class="def-explorer-main" href={lienEpoque(it.name) ?? it.frise}>Voir l’époque sur la frise des courants →</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
      </>
      ))}
    </section>
  ))}
  <div class="drawer-intro-sep def-sep" aria-hidden="true">
    <span class="drawer-intro-sep-line"></span>
    <span class="drawer-intro-sep-ornament">✦</span>
    <span class="drawer-intro-sep-line"></span>
  </div>

  <!-- La Frise et le Tableau des courants (composant réutilisable), juste avant « Continuer le voyage » -->
  <CartoucheMonde vue="courants" />

  <Voyage href="/philosophes-d-aujourd-hui/" />
</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/plan-du-site/" aria-label="Plan du site">
      <span class="footer-social-icon">🗺</span>
      <span class="footer-social-label">Plan du site</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/home-portraits.js" defer></script>
<script src="/js/accordion.js" defer></script>

</body>
</html>
