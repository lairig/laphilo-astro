---
import Favicons from '../components/Favicons.astro';
import SeoHead from '../components/SeoHead.astro';
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <title>Lairig Music — La Philo</title>
  <meta name="description" content="Lairig, projet de musique instrumentale aux sonorités orientales et new age, tissé pour accompagner la réflexion et la méditation philosophique." />
  <SeoHead
    title="Lairig Music — La Philo"
    description="Lairig, projet de musique instrumentale aux sonorités orientales et new age, tissé pour accompagner la réflexion et la méditation philosophique."
    path="/lairig/"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/definition.css" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Lairig Music</h1>
  <p class="site-subtitle">L'autre face du projet — musique instrumentale &amp; philosophie</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main class="definition-page">
<div class="soc-page-wrap">

  <div class="soc-lairig-header">
    <div class="soc-lairig-logo-wrap">
      <img src="/photo/logo-lairig.webp" class="soc-lairig-logo" alt="Lairig" />
    </div>
    <div class="soc-lairig-info">
      <div class="soc-tags">
        <span class="soc-tag soc-tag--ambient">Ambient</span>
        <span class="soc-tag soc-tag--newage">New Age</span>
        <span class="soc-tag soc-tag--oriental">Oriental</span>
      </div>
      <p class="soc-lairig-desc">
        <strong>Lairig</strong> est un projet de musique instrumentale aux sonorités orientales et new age — tissé pour accompagner la réflexion et la méditation philosophique. Chaque morceau traverse une ère de la pensée humaine, de la Grèce antique aux rivages contemporains.
      </p>
      <a href="https://lairig.com" target="_blank" rel="noopener" class="soc-btn-web">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#d4a843"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93s3.06-7.44 7-7.93v15.86zm2-15.86c1.03.13 2 .45 2.87.93H13v-.93zM13 7h5.24c.25.31.48.65.68 1H13V7zm0 3h6.74c.08.33.15.66.19 1H13v-1zm0 9.93V19h2.87c-.87.48-1.84.8-2.87.93zM18.24 17H13v-1h5.92c-.2.35-.43.69-.68 1zm1.5-3H13v-1h6.93c-.04.34-.11.67-.19 1z"></path></svg>
