    </div>
  </div>

  <div class="soc-photo-grid-2">
    <div class="soc-photo-frame--16-9">
      <img src="/photo/lairig-main.webp" alt="Lairig" />
    </div>
    <div class="soc-photo-frame--16-9">
      <img src="/photo/lairig-aouei.webp" alt="Lairig" />
    </div>
  </div>

  <div class="soc-album-card">
