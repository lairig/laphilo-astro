---
/* Plan du site en arbre (validé le 2026-10-06) : tout le site sous forme d'arborescence
   qu'on déplie, avec un champ de recherche qui filtre l'arbre et ouvre les branches trouvées.
   Feuilles : les pages, les frises (catalogue de /frises/ : une frise ajoutée au catalogue
   apparaît ici automatiquement), les familles de courants, et toutes les fiches
   (philosophes par tradition, courants par famille). */
import { getCollection } from 'astro:content';
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import Arbre from '../components/Arbre.astro';
import type { Noeud } from '../lib/arbre';
import catalogue from '../data/frises-catalogue.json';
import { groupesMonde } from '../data/groupes-monde';


const groups: any[] = catalogue.groups;
const byLabel = (label: string): any[] => groups.find((g) => g.label === label)?.items ?? [];
const period = (tag?: string) =>
  tag && !['Toutes époques', 'en activité'].includes(tag) ? tag.replace(/-(\d+ av)/g, '$1') : undefined;
const clean = (name: string) => {
  const s = name.replace(/&amp;/g, '&')
    .replace(/^(Tous les|Toutes les|Toute la)\s+/, '')
    .replace(/^Philosophes\s+/, '')
    .replace(/^(Modernes|Contemporains)\s+/, '')
    .replace(/^vivants\s*:\s*/i, '')
    .replace(/^(d'|de l'|du |des )/, '');
  return s.charAt(0).toUpperCase() + s.slice(1);
};
const frise = (it: any, label?: string): Noeud => ({ label: label ?? clean(it.name), href: it.href, note: period(it.tag) });
const an = (y: number) => (y < 0 ? `${-y} av. J.-C.` : String(y));

const philosophes = (await getCollection('philosophes')).slice().sort((a, b) => a.data.year - b.data.year);
const courants = (await getCollection('courants')).slice().sort((a, b) => a.data.year - b.data.year);
const monde = byLabel('La Frise des Penseurs du Monde')[0];
const mondeLien = (label: string) => monde.links.find((l: any) => l.label === label)?.href ?? '/frises/penseurs-du-monde/';

/* Philosophes : par grande tradition, du plus ancien au plus récent */
const philosophesParTradition: Noeud[] = groupesMonde
  .map((g) => ({
    label: g.label, note: `${philosophes.filter((p) => p.data.groupe === g.id).length} fiches`,
    enfants: philosophes.filter((p) => p.data.groupe === g.id)
      .map((p) => ({ label: p.data.name, href: `/philosophes/${p.id}/`, note: p.data.display_date, fiche: true })),
  }))
  .filter((n) => n.enfants.length);

/* Courants : familles (mouvements) dans leur tradition majoritaire, puis grands débats (positions) */
const parFamille = new Map<string, typeof courants>();
for (const c of courants) {
  if (!c.data.famille) continue;
  if (!parFamille.has(c.data.famille)) parFamille.set(c.data.famille, []);
  parFamille.get(c.data.famille)!.push(c);
}
const ficheCourant = (c: (typeof courants)[number]): Noeud => ({ label: c.data.name, href: `/courants/${c.id}/`, note: c.data.display_date, fiche: true });
const lienFamille = (f: string) => `/frises/courants-du-monde/?famille=${encodeURIComponent(f)}`;
const familles = [...parFamille.entries()].filter(([, m]) => m[0].data.nature === 'mouvement').map(([nom, m]) => {
  const compte = new Map<string, number>();
  m.forEach((c) => compte.set(c.data.groupe ?? '', (compte.get(c.data.groupe ?? '') ?? 0) + 1));
  return { nom, membres: m, tradition: [...compte.entries()].sort((a, b) => b[1] - a[1])[0][0] };
});
const famillesParTradition: Noeud[] = groupesMonde
  .map((g) => ({
    label: g.label,
    enfants: familles.filter((f) => f.tradition === g.id).sort((a, b) => a.membres[0].data.year - b.membres[0].data.year)
      .map((f) => ({ label: f.nom, href: lienFamille(f.nom), note: `${f.membres.length} courants`, enfants: f.membres.map(ficheCourant) })),
  }))
  .filter((n) => n.enfants.length);
const debats: Noeud[] = [...parFamille.entries()].filter(([, m]) => m[0].data.nature === 'position')
  .map(([q, m]) => ({ label: q, href: lienFamille(q), note: `${m.length} réponses`, enfants: m.map(ficheCourant) }));
const courantsCatalogue = byLabel('Les Courants de Pensée');

const arbre: Noeud = {
  label: 'LaPhilo.fr', href: '/', ouvert: true,
  enfants: [
    { label: 'Commencer', ouvert: true, enfants: [
      { label: 'Accueil', href: '/' },
      { label: 'Nouveau ici ?', href: '/bienvenue/' },
      { label: 'C’est quoi la philosophie ?', href: '/definition/' },
    ] },
    { label: 'Comprendre', ouvert: true, enfants: [
      { label: 'Histoire des philosophes', href: '/histoire-des-philosophes/' },
      { label: 'Histoire des courants de pensée', href: '/histoire-des-courants/' },
      { label: 'Familles de pensée et grands débats', href: '/familles-de-pensee/' },
    ] },
    { label: 'Les philosophes', note: `${philosophes.length} fiches`, enfants: [
      { label: 'Le monde entier', enfants: [
        { label: 'Frise des penseurs du monde', href: mondeLien("Vue d'ensemble"), note: period(monde.tag) },
        { label: 'Tableau des penseurs', href: '/frises/tableau-des-penseurs/' },
        { label: 'Les femmes dans l’histoire', href: mondeLien('Femmes uniquement') },
        ...[['Âge axial', '650 → 150 av. J.-C.'], ["Âge d'or islamique", '750 → 1300'], ['XIXᵉ siècle', '1780 → 1950']]
          .map(([l, note]) => ({ label: `Période : ${l}`, href: mondeLien(l), note })),
      ] },
      { label: 'Par époque', enfants: [
        { label: 'Contemporains', enfants: byLabel('Contemporains').map((it) => frise(it)) },
        { label: 'Époque moderne', enfants: [...byLabel('Modernes')].sort((a, b) => parseInt(b.tag) - parseInt(a.tag)).map((it) => frise(it)) },
        { label: 'Renaissance, Moyen Âge, Antiquité', enfants: byLabel('Anciens').map((it) => frise(it)).reverse() },
      ] },
      { label: 'Par pays', enfants: byLabel('Par pays').map((it) => frise(it)) },
      { label: 'Par grande tradition', enfants: [...byLabel('Par grande tradition'), ...byLabel('Par thème')].map((it) => frise(it)) },
      { label: 'Aujourd’hui', enfants: [
        { label: 'Les philosophes d’aujourd’hui', href: '/philosophes-d-aujourd-hui/' },
        ...byLabel('Vivants par sujet de travail').map((it) => frise(it)),
      ] },
      { label: 'Toutes les fiches, par tradition', enfants: philosophesParTradition },
    ] },
    { label: 'Les courants de pensée', note: `${courants.length} fiches`, enfants: [
      { label: 'Frise des courants du monde', href: '/frises/courants-du-monde/' },
      { label: 'Tableau des courants', href: '/frises/tableau-des-courants/' },
      { label: 'Frises par tradition et par question', enfants: courantsCatalogue.map((it: any) => ({
        label: it.name.replace(/^La /, '').replace(/&amp;/g, '&'),
        enfants: it.links.map((l: any) => ({ label: l.label.replace(/&amp;/g, '&'), href: l.href })),
      })) },
      { label: 'Les familles de pensée', href: '/familles-de-pensee/', note: `${familles.length} familles`, enfants: famillesParTradition },
      { label: 'Les grands débats', href: '/familles-de-pensee/#debats', note: `${debats.length} questions`, enfants: debats },
    ] },
    { label: 'Trouver', enfants: [
      { label: 'Recherche', href: '/recherche/', note: 'philosophes, courants, frises' },
      { label: 'Toutes les frises', href: '/frises/' },
    ] },
    { label: 'À propos', enfants: [
      { label: 'Pourquoi ce site', href: '/pourquoi/' },
      { label: 'Ressources utilisées', href: '/ressources/' },
      { label: 'Vos remarques', href: '/vos-remarques/' },
      { label: 'Musique Lairig', href: '/lairig/' },
    ] },
  ],
};
const nbFiches = philosophes.length + courants.length;
const description = "Plan du site LaPhilo.fr en arbre : toutes les pages, les frises et les fiches des philosophes et des courants de pensée, avec une recherche.";
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>Plan du site | LaPhilo.fr</title>
  <meta name="description" content={description} />
  <SeoHead title="Plan du site | LaPhilo.fr" description={description} path="/plan-du-site/" ariane={[['Plan du site', '/plan-du-site/']]} />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<header class="site-header">
  <div class="sitemap-switcher">
    <BackButton />
    <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
      <span class="sitemap-flag" aria-hidden="true">⌂</span>
      <span class="sitemap-text">Accueil</span>
    </a>
  </div>
  <h1 class="site-title">Plan du site</h1>
  <p class="site-subtitle">Tout le site en arbre</p>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<main>
  <Arbre racine={arbre} label="Plan du site" placeholder={`Chercher une page, une frise ou l’une des ${nbFiches} fiches…`} />
</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
    <a class="footer-social-btn" href="/vos-remarques/" aria-label="Vos remarques">
      <span class="footer-social-icon">✎</span>
      <span class="footer-social-label">Vos remarques</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/home-portraits.js" defer></script>

</body>
</html>
