---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import catalogue from '../data/frises-catalogue.json';

/* Plan du site : index compact de liens, pensé pour un accès rapide.
   Les frises viennent du catalogue de /frises/ : une frise ajoutée au
   catalogue apparaît ici automatiquement. */
type Link = { label: string; href: string; note?: string };
type Block = { id: string; title: string; short: string; links: Link[] };

const groups: any[] = catalogue.groups;
const byLabel = (label: string) => groups.find((g) => g.label === label)?.items ?? [];
/* « -650 av. J.-C. » → « 650 av. J.-C. » */
const period = (tag?: string) => (tag && tag !== 'Toutes époques' ? tag.replace(/-(\d+ av)/g, '$1') : undefined);
const shortName = (name: string) =>
  name.replace(/^Tous les Philosophes (du |des )?/, '').replace(/^Philosophes /, '');

const courants: Link[] = byLabel('Les Courants de Pensée').flatMap((it: any) =>
  it.links.map((l: any) => ({
    label: l.label === 'Frise complète' ? `${it.name.replace(/^La /, '')} — frise complète` : `${it.name.replace(/^La /, '')} — ${l.label}`,
    href: l.href,
  })),
);
const frise = (it: any): Link => ({ label: shortName(it.name), href: it.href, note: period(it.tag) });
/* Anciens dans l'ordre chronologique (le catalogue les range du plus récent au plus ancien) ; Orientaux en dernier */
const anciens = byLabel('Anciens');
const anciensChrono = [...anciens.filter((it: any) => !/Orientaux/.test(it.name)).reverse(), ...anciens.filter((it: any) => /Orientaux/.test(it.name))];

const blocks: Block[] = [
  {
    id: 'decouvrir',
    title: 'Découvrir',
    short: 'Découvrir',
    links: [
      { label: 'Accueil', href: '/' },
      { label: 'Recherche (philosophes, courants, frises)', href: '/recherche/' },
      { label: 'C’est quoi la philosophie ?', href: '/definition/' },
      { label: 'Histoire des philosophes', href: '/histoire-des-philosophes/' },
      { label: 'Histoire des courants', href: '/histoire-des-courants/' },
      { label: 'Toutes les frises (présentées)', href: '/frises/' },
    ],
  },
  { id: 'courants', title: 'Frises des courants de pensée', short: 'Courants', links: courants },
  {
    id: 'epoques',
    title: 'Frises des philosophes par époque',
    short: 'Philosophes par époque',
    links: [...anciensChrono, ...byLabel('Modernes'), ...byLabel('Contemporains')].map(frise),
  },
  { id: 'origines', title: 'Frises des philosophes par origine (toutes époques)', short: 'Philosophes par origine', links: byLabel('Par Nationalité').map(frise) },
  {
    id: 'site',
    title: 'Le site',
    short: 'Le site',
    links: [
      { label: 'Pourquoi ce site ?', href: '/pourquoi/' },
      { label: 'Musique Lairig', href: '/lairig/' },
      { label: 'Ressources utilisées', href: '/ressources/' },
      { label: 'Échanges & contact', href: '/echanges/' },
    ],
  },
];
const description = "Plan du site LaPhilo.fr — accédez rapidement à toutes les frises chronologiques des philosophes et courants de pensée, et aux pages de contenu et ressources du site.";
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>Plan du site | LaPhilo.fr</title>
  <meta name="description" content={description} />
  <SeoHead title="Plan du site | LaPhilo.fr" description={description} path="/plan-du-site/" />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    .pds { max-width: 1100px; margin: 0 auto; padding: 0 1rem 3rem; }
    .pds-hero { padding-bottom: 1.2rem; }

    /* Sommaire : saut direct vers une rubrique */
    .pds-toc {
      display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem;
      margin: 0 0 2rem; padding: 0; list-style: none;
    }
    .pds-toc a {
      display: inline-block; padding: .45rem .9rem;
      font-family: 'Cinzel', serif; font-size: .78rem; font-weight: 600; letter-spacing: .05em;
      color: #f7ecce; text-decoration: none;
      border: 1px solid rgba(212, 168, 67, .5); border-radius: 4px;
      background: rgba(30, 18, 8, .7);
    }
    .pds-toc a:hover, .pds-toc a:focus-visible { background: rgba(180, 130, 20, .25); border-color: #d4a843; }

    /* Rubriques : colonnes sur grand écran, une seule sur mobile */
    .pds-grid {
      display: grid; gap: 1.2rem;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      align-items: start;
    }
    .pds-block {
      padding: 1rem 1.2rem 1.1rem;
      background: rgba(30, 18, 8, .75);
      border: 1px solid rgba(212, 168, 67, .35);
      border-radius: 6px;
      scroll-margin-top: 1rem;
    }
    .pds-block h2 {
      margin: 0 0 .6rem; padding-bottom: .45rem;
      font-family: 'Cinzel', serif; font-size: .9rem; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #d4a843;
      border-bottom: 1px solid rgba(212, 168, 67, .3);
    }
    .pds-block ul { margin: 0; padding: 0; list-style: none; }
    .pds-block li + li { border-top: 1px solid rgba(212, 168, 67, .1); }
    .pds-block a {
      display: flex; justify-content: space-between; align-items: baseline; gap: .8rem;
      padding: .42rem .2rem;
      font-family: 'EB Garamond', serif; font-size: 1.08rem; line-height: 1.3;
      color: #f7ecce; text-decoration: none;
    }
    .pds-block a:hover, .pds-block a:focus-visible { color: #fff; background: rgba(180, 130, 20, .15); outline: none; }
    .pds-block a:hover .pds-label { text-decoration: underline; text-underline-offset: 3px; }
    .pds-note { flex-shrink: 0; font-size: .85rem; font-style: italic; color: #c9a96e; white-space: nowrap; }
    .pds-hint { margin: 1.6rem 0 0; text-align: center; font-family: 'EB Garamond', serif; font-size: .95rem; font-style: italic; color: #c9a96e; }

    @media (max-width: 480px) {
      .pds-toc { gap: .35rem; margin-bottom: 1.4rem; }
      .pds-toc a { padding: .35rem .6rem; font-size: .7rem; }
      .pds-grid { grid-template-columns: 1fr; }
      .pds-block { padding: .8rem .9rem .9rem; }
    }
  </style>
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<main class="pds">

  <header class="site-header pds-hero">
    <div class="sitemap-switcher">
      <BackButton />
      <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
        <span class="sitemap-flag" aria-hidden="true">⌂</span>
        <span class="sitemap-text">Accueil</span>
      </a>
    </div>
    <h1 class="site-title">Plan du site</h1>
    <div class="header-rule" aria-hidden="true"></div>
  </header>

  <nav aria-label="Rubriques du plan du site">
    <ul class="pds-toc">
      {blocks.map((b) => <li><a href={`#${b.id}`}>{b.short}</a></li>)}
    </ul>
  </nav>

  <div class="pds-grid">
    {blocks.map((b) => (
      <section class="pds-block" id={b.id}>
        <h2>{b.title}</h2>
        <ul>
          {b.links.map((l) => (
            <li>
              <a href={l.href}>
                <span class="pds-label" set:html={l.label} />
                {l.note && <span class="pds-note">{l.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <p class="pds-hint">Les frises s’ouvrent dans un nouvel onglet.</p>

</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/home-portraits.js" defer></script>

</body>
</html>
