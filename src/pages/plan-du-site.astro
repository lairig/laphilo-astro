---
import Favicons from '../components/Favicons.astro';
import BackButton from '../components/BackButton.astro';
import Fonts from '../components/Fonts.astro';
import GoatCounter from '../components/GoatCounter.astro';
import SeoHead from '../components/SeoHead.astro';
import catalogue from '../data/frises-catalogue.json';

/* Plan du site : rubriques compactes, empilées en colonnes (sans trous).
   Les frises viennent du catalogue de /frises/ : une frise ajoutée au
   catalogue apparaît ici automatiquement, dans la rubrique de son groupe. */
type Link = { label: string; href: string; note?: string };
type Group = { title?: string; links: Link[] };
type Block = { id: string; col: 1 | 2 | 3; title: string; nav: string; groups: Group[] };

const groups: any[] = catalogue.groups;
const byLabel = (label: string): any[] => groups.find((g) => g.label === label)?.items ?? [];
/* « -650 av. J.-C. → 500 » → « 650 av. J.-C. → 500 » ; pas de date pour « Toutes époques » ou « en activité » */
const period = (tag?: string) =>
  tag && !['Toutes époques', 'en activité'].includes(tag) ? tag.replace(/-(\d+ av)/g, '$1') : undefined;
/* Libellés courts : « Tous les Philosophes d'Asie de l'Est » → « Asie de l'Est » */
const clean = (name: string) => {
  const s = name
    .replace(/^(Tous les|Toutes les)\s+/, '')
    .replace(/^Philosophes\s+/, '')
    .replace(/^(Modernes|Contemporains)\s+/, '')
    .replace(/^vivants\s*:\s*/i, '')
    .replace(/^(d'|de l'|du |des )/, '')
    .replace(/ &amp; (du |de la |d')/, ' &amp; ');
  return s.charAt(0).toUpperCase() + s.slice(1);
};
const frise = (it: any, label?: string): Link => ({ label: label ?? clean(it.name), href: it.href, note: period(it.tag) });
/* « Autres Philosophes Modernes / Contemporains » → « Autres pays » */
const autres = (it: any) => frise(it, /^Autres/.test(it.name) ? 'Autres pays' : undefined);

const monde = byLabel('La Frise des Penseurs du Monde')[0];
const mondeLien = (label: string) => monde.links.find((l: any) => l.label === label)?.href ?? '/frises/penseurs-du-monde/';
const courant = (it: any): Group => ({
  title: it.name.replace(/^La /, ''),
  links: it.links.map((l: any) => ({ label: l.label, href: l.href })),
});

const blocks: Block[] = [
  {
    id: 'site', col: 1, nav: 'Le site', title: 'Le site',
    groups: [
      { title: 'Commencer', links: [
        { label: 'Accueil', href: '/' },
        { label: 'Nouveau ici ?', href: '/bienvenue/' },
        { label: 'C’est quoi la philosophie ?', href: '/definition/' },
      ] },
      { title: 'Comprendre', links: [
        { label: 'Histoire des philosophes', href: '/histoire-des-philosophes/' },
        { label: 'Histoire des courants de pensée', href: '/histoire-des-courants/' },
      ] },
      { title: 'Trouver', links: [
        { label: 'Recherche', href: '/recherche/', note: 'philosophes, courants, frises' },
        { label: 'Toutes les frises', href: '/frises/', note: 'présentées' },
        ...byLabel('Par thème').map((it) => frise(it, 'Pensée féminine')),
      ] },
      { title: 'À propos', links: [
        { label: 'Pourquoi ce site', href: '/pourquoi/' },
        { label: 'Ressources utilisées', href: '/ressources/' },
        { label: 'Échanges & contact', href: '/echanges/' },
        { label: 'Musique Lairig', href: '/lairig/' },
      ] },
    ],
  },
  {
    id: 'monde', col: 1, nav: 'Frise du monde', title: 'Frise complète du monde',
    groups: [
      { links: [
        { label: 'Frise des penseurs du monde', href: mondeLien("Vue d'ensemble"), note: period(monde.tag) },
        { label: 'Tableau des penseurs', href: '/frises/a-la-meme-epoque/', note: 'qui pensait quoi, et où' },
        { label: 'Les femmes dans l’histoire', href: mondeLien('Femmes uniquement'), note: period(byLabel('Par thème')[0]?.tag) },
      ] },
      { title: 'Grandes périodes', links: /* dates des préréglages de /frises/penseurs-du-monde/ */
        [['Âge axial', '650 av. J.-C. → 150 av. J.-C.'], ["Âge d'or islamique", '750 → 1300'], ['XIXᵉ siècle', '1780 → 1950']]
          .map(([l, note]) => ({ label: l, href: mondeLien(l), note })) },    ],
  },
  {
    id: 'courants', col: 2, nav: 'Courants', title: 'Courants de pensée',
    groups: byLabel('Les Courants de Pensée').map(courant),
  },
  {
    id: 'traditions', col: 2, nav: 'Par tradition', title: 'Philosophes par tradition',
    groups: [
      { title: 'Grandes traditions, toutes époques', links: byLabel('Par grande tradition').map((it) => frise(it)) },
    ],
  },
  {
    id: 'pays', col: 2, nav: 'Par pays', title: 'Philosophes par pays',
    groups: [{ title: 'Toutes époques', links: byLabel('Par pays').map((it) => frise(it)) }],
  },
  {
    id: 'aujourdhui', col: 3, nav: 'Aujourd’hui', title: 'Philosophes d’aujourd’hui',
    groups: [
      { links: [{ label: 'Les philosophes d’aujourd’hui', href: '/philosophes-d-aujourd-hui/', note: 'par sujet et par région' }] },
      { title: 'Contemporains', links: byLabel('Contemporains').map(autres) },
      { title: 'Vivants, par sujet de travail', links: byLabel('Vivants par sujet de travail').map((it) => frise(it)) },
    ],
  },
  {
    id: 'epoques', col: 3, nav: 'Par époque', title: 'Philosophes par époque',
    groups: [
      /* du plus récent (en haut) au plus ancien (Proche-Orient ancien tout en bas) */
      { title: 'Époque moderne', links: [...byLabel('Modernes')].sort((a, b) => parseInt(b.tag) - parseInt(a.tag)).map(autres) },
      { title: 'Renaissance, Moyen Âge, Antiquité', links: byLabel('Anciens').map((it) => frise(it)).reverse() },
    ],
  },
];
const description = "Plan du site LaPhilo.fr — accédez rapidement à toutes les frises chronologiques des philosophes et courants de pensée, et aux pages de contenu et ressources du site.";
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Favicons />
  <GoatCounter />
  <title>Plan du site | LaPhilo.fr</title>
  <meta name="description" content={description} />
  <SeoHead title="Plan du site | LaPhilo.fr" description={description} path="/plan-du-site/" />

  <Fonts />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    .pds { max-width: 1180px; margin: 0 auto; padding: 0 1rem 2.5rem; }
    .pds-hero { padding-bottom: 1rem; }

    /* Sommaire : accès direct à chaque rubrique */
    .pds-sommaire { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem; margin: 0 0 1.6rem; padding: 0; list-style: none; }
    .pds-sommaire a {
      display: inline-block; padding: .35rem .8rem; border-radius: 999px; text-decoration: none;
      font-family: 'Cinzel', serif; font-size: .66rem; letter-spacing: .08em; text-transform: uppercase;
      color: #d4a843; border: 1px solid rgba(212, 168, 67, .4); background: rgba(30, 18, 8, .6);
    }
    .pds-sommaire a:hover, .pds-sommaire a:focus-visible { background: rgba(180, 130, 20, .2); border-color: #d4a843; color: #f7ecce; outline: none; }
    /* Utile seulement quand les rubriques sont sur une colonne (mobile) */
    @media (min-width: 900px) { .pds-sommaire { display: none; } }

    /* 3 colonnes fixes (champ col de chaque rubrique) ; une seule sur mobile */
    .pds-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.1rem; align-items: start; }
    @media (max-width: 899px) { .pds-grid { grid-template-columns: 1fr; } }
    .pds-block {
      display: block; width: 100%; margin: 0 0 1.1rem;
      padding: .9rem 1.1rem .7rem;
      background: rgba(30, 18, 8, .75);
      border: 1px solid rgba(212, 168, 67, .35); border-top: 3px solid #d4a843;
      border-radius: 6px;
      scroll-margin-top: 1rem;
    }
    .pds-block h2 {
      margin: 0 0 .3rem;
      font-family: 'Cinzel', serif; font-size: .88rem; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #d4a843;
    }
    .pds-block h3 {
      margin: .65rem 0 .1rem; padding-bottom: .2rem;
      font-family: 'Cinzel', serif; font-size: .62rem; font-weight: 400; letter-spacing: .12em;
      text-transform: uppercase; color: #c9a96e;
      border-bottom: 1px solid rgba(212, 168, 67, .22);
    }
    .pds-block h2 + h3 { margin-top: .4rem; }
    .pds-block ul { margin: 0; padding: 0; list-style: none; }
    .pds-block li + li { border-top: 1px solid rgba(212, 168, 67, .08); }
    .pds-block a {
      display: flex; justify-content: space-between; align-items: baseline; gap: .8rem;
      padding: .3rem .2rem;
      font-family: 'EB Garamond', serif; font-size: 1.04rem; line-height: 1.25;
      color: #f7ecce; text-decoration: none;
    }
    .pds-block a:hover, .pds-block a:focus-visible { color: #fff; background: rgba(180, 130, 20, .15); outline: none; }
    .pds-block a:hover .pds-label { text-decoration: underline; text-underline-offset: 3px; }
    .pds-note { flex-shrink: 0; font-size: .84rem; font-style: italic; color: #c9a96e; white-space: nowrap; }

    @media (max-width: 480px) {
      .pds-block { padding: .8rem .9rem .6rem; }
      .pds-block a { padding: .5rem .2rem; }
      .pds-note { font-size: .8rem; }
    }
  </style>
</head>
<body>

<a href="#" id="back-to-top" title="Remonter en haut de la page" aria-label="Remonter en haut de la page">↑</a>

<main class="pds">

  <header class="site-header pds-hero">
    <div class="sitemap-switcher">
      <BackButton />
      <a href="/" class="sitemap-btn" aria-label="Retour à l'accueil">
        <span class="sitemap-flag" aria-hidden="true">⌂</span>
        <span class="sitemap-text">Accueil</span>
      </a>
    </div>
    <h1 class="site-title">Plan du site</h1>
    <div class="header-rule" aria-hidden="true"></div>
  </header>

  <nav aria-label="Rubriques du plan du site">
    <ul class="pds-sommaire">
      {blocks.map((b) => <li><a href={`#${b.id}`}>{b.nav}</a></li>)}
    </ul>
  </nav>

  <div class="pds-grid">
    {[1, 2, 3].map((c) => (
    <div class="pds-col">
    {blocks.filter((b) => b.col === c).map((b) => (
      <section class="pds-block" id={b.id}>
        <h2>{b.title}</h2>
        {b.groups.map((g) => (
          <>
            {g.title && <h3>{g.title}</h3>}
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>
                    <span class="pds-label" set:html={l.label} />
                    {l.note && <span class="pds-note">{l.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>
    ))}
    </div>
    ))}
  </div>


</main>

<footer class="site-footer">
  <nav class="footer-social-nav" aria-label="Lien Social">
    <a class="footer-social-btn" href="/" aria-label="Accueil">
      <span class="footer-social-icon">⌂</span>
      <span class="footer-social-label">Accueil</span>
    </a>
    <a class="footer-social-btn" href="/recherche/" aria-label="Recherche">
      <span class="footer-social-icon">🔍</span>
      <span class="footer-social-label">Recherche</span>
    </a>
  </nav>
  <p>© 2026 – laphilo.fr – Tous droits réservés</p>
</footer>

<script src="/js/home-main.js" defer></script>
<script src="/js/home-portraits.js" defer></script>

</body>
</html>
