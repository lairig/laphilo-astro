---
/* Bouton « Retour » de l'en-tête : revient à la page précédente.
   Affiché seulement quand on arrive d'une autre page du site, pour ne
   jamais renvoyer vers Google ou hors du site.
   variant « sitemap » : cadre des pages de contenu (à côté de Plan du site / Accueil)
   variant « fha »     : en-tête des frises et des fiches */
interface Props {
  variant?: 'sitemap' | 'fha';
}
const { variant = 'sitemap' } = Astro.props;
---
{variant === 'sitemap' ? (
  <button type="button" class="sitemap-btn sitemap-back" data-back aria-label="Revenir à la page précédente" hidden>
    <span class="sitemap-flag" aria-hidden="true">←</span>
    <span class="sitemap-text">Retour</span>
  </button>
) : (
  <button type="button" class="fha-btn fha-back" data-back aria-label="Revenir à la page précédente" hidden>
    <span class="fha-ico" aria-hidden="true">←</span> <span class="fha-lbl">Retour</span>
  </button>
)}

<script>
  let fromSite = false;
  try {
    fromSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
  } catch {}
  if (fromSite && history.length > 1) {
    document.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) => {
      btn.hidden = false;
      btn.addEventListener('click', () => history.back());
    });
  }
</script>

<style>
  /* Séparation avec le bouton voisin dans le même cadre */
  .sitemap-back { border-right: 1px solid rgba(200, 150, 42, .35); }
  [data-back][hidden] { display: none; }
</style>
