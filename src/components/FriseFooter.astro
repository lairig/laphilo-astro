---
/* Pied de page des frises et des fiches : lien « Vos remarques », liens de navigation, copyright.
   fiche : chemin de la fiche (« /philosophes/emmanuel-kant/ »), choisie d'avance sur la page des remarques. */
interface Props {
  fiche?: string;
}
const { fiche } = Astro.props;
---
<footer class="frise-footer">
  <p class="ff-tagline footer-tagline">
    {fiche
      ? <a class="ff-remarque" href={`/vos-remarques/?fiche=${encodeURIComponent(fiche)}#laisser`}>Une remarque sur cette fiche ?</a>
      : <a class="ff-remarque" href="/vos-remarques/#laisser">Une remarque ? Écrivez-nous</a>}
  </p>
  <div class="ff-bottom">
    <nav class="ff-links" aria-label="Navigation du site">
      <a href="/">⌂ Accueil</a>
      <span aria-hidden="true">·</span>
      <a href="/frises/">Toutes les frises</a>
      <span aria-hidden="true">·</span>
      <a href="/plan-du-site/">Plan du site</a>
      <span aria-hidden="true">·</span>
      <a href="/vos-remarques/">Vos remarques</a>
    </nav>
    <p class="ff-copy">© 2026 – laphilo.fr – Tous droits réservés</p>
  </div>
</footer>

<style>
  /* Liens de navigation, puis le copyright seul sur la dernière ligne */
  .ff-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .4rem;
  }
  .ff-bottom .ff-copy { white-space: nowrap; }
  .ff-links {
    display: flex;
    align-items: center;
    gap: .55rem;
    font-family: 'Cinzel', serif;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(212, 168, 67, .55);
  }
  .ff-links a {
    color: var(--gold-light, #d4a843);
    text-decoration: none;
    opacity: .85;
    transition: opacity .2s;
  }
  .ff-links a:hover { opacity: 1; text-decoration: underline; }
  /* Le lien garde l'allure de l'ancienne devise */
  .ff-remarque { color: inherit; text-decoration: none; border-bottom: 1px dotted currentColor; }
  .ff-remarque:hover { border-bottom-style: solid; }
  @media (max-width: 480px) {
    .ff-links { flex-wrap: wrap; justify-content: center; row-gap: .25rem; }
  }
</style>
