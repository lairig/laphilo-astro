---
interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, jsonLd = [] } = Astro.props;
const url = new URL(path, Astro.site).toString();
const ogImage = new URL('/og-banner.webp', Astro.site).toString();
---

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={url} />
<meta name="author" content="LaPhilo.fr" />
<meta name="theme-color" content="#2b1d0e" />
<script src="/js/media-exclusive.js?v=20261001" defer></script>
{/* Taille de base du texte sur tout le site (16 px par défaut) : un peu plus grande
    pour la lisibilité ; toutes les tailles en rem suivent. */}
<style is:inline>html { font-size: 109.375%; }</style>
{/* Les frises s'ouvrent dans un nouvel onglet, sauf depuis une frise
    (passer d'une frise à l'autre reste dans le même onglet). Réglé au clic :
    couvre aussi les liens créés en JavaScript (résultats de recherche). */}
<script is:inline>
  (function () {
    var FRISE = /^\/(philosophes|courants)\/frise\//;
    if (FRISE.test(location.pathname)) return;
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || a.target || a.origin !== location.origin || !FRISE.test(a.pathname)) return;
      a.target = '_blank';
      a.rel = (a.rel ? a.rel + ' ' : '') + 'noopener';
    }, true);
  })();
</script>

<meta property="og:type" content="website" />
<meta property="og:site_name" content="LaPhilo.fr" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="LaPhilo.fr – Frises chronologiques de philosophie" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="LaPhilo.fr – Frises chronologiques de philosophie" />

{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
