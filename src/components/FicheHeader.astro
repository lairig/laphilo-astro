---
import BackButton from './BackButton.astro';

interface Props {
  title: string;
  listHref: string;
}

const { title, listHref } = Astro.props;
---

<header class="frise-header">
  <div class="frise-header-actions">
    <div class="fha-left">
      <BackButton variant="fha" />
      <a href="/" class="fha-btn fha-home" aria-label="Accueil"><span class="fha-ico" aria-hidden="true">⌂</span> <span class="fha-lbl">Accueil</span></a>
    </div>
    <div class="fha-right">
      <a href={listHref} class="fha-btn" aria-label="Frise complète"><span class="fha-ico" aria-hidden="true">&#9776;</span> <span class="fha-lbl">Frise complète</span></a>
      <a href="/recherche/" class="fha-btn" aria-label="Recherche"><span class="fha-ico" aria-hidden="true">&#128269;</span> <span class="fha-lbl">Recherche</span></a>
    </div>
  </div>
  <h1>{title}</h1>
  <div class="header-rule"></div>
</header>

<style>
  /* De l'air entre les boutons et le nom de la fiche. */
  .frise-header-actions { margin-bottom: 1.6rem; }
  @media (max-width: 640px) {
    .frise-header-actions { margin-bottom: 1.3rem; }
  }
</style>
